-- Hàm cập nhật UI
function UpdateUI()
    local currentIsland = GetCurrentIsland()
    if currentIsland then
        CurrentPosLabel.Text = "📍 Vị trí: " .. currentIsland
        CurrentPosLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
        
        local islands = GetIslandsToTeleport()
        if #islands > 0 then
            RouteLabel.Text = "Route: " .. table.concat(islands, " → ")
            RouteLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        else
            RouteLabel.Text = "✅ Đã ở đảo thấp nhất!"
            RouteLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    else
        CurrentPosLabel.Text = "📍 Không xác định được vị trí"
        CurrentPosLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        RouteLabel.Text = "Route: Celestial → OG → Hacked → Divine → Secret → Godly → Mythic → Legend → Epic → Rare → Common"
        RouteLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
    end
    
    -- Cập nhật brainrot/animal status
    local isBrainrot = IsBrainrot()
    local isAnimal = IsAnimal()
    StatusExtra.Text = "🧠 Brainrot: " .. (isBrainrot and "✅" or "❌") .. " | 🐾 Animal: " .. (isAnimal and "✅" or "❌")
    
    if Settings.Enabled then
        StatusLabel.Text = "▶ ĐANG TELEPORT..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
        ToggleLabel.Text = "Đang chạy..."
    else
        StatusLabel.Text = "⏹ Sẵn sàng"
        StatusLabel.TextColor3 = Color3.fromRGB(120, 120, 150)
        ToggleLabel.Text = "Bắt đầu Teleport"
    end
end

-- Toggle functions
local brainrotOn = true
local function ToggleBrainrot()
    brainrotOn = not brainrotOn
    Settings.BrainrotEnabled = brainrotOn
    
    if brainrotOn then
        BrainrotToggle.ImageColor3 = Color3.fromRGB(0, 200, 80)
        BrainrotToggleInd.Position = UDim2.new(0, 29, 0.5, -9)
        BrainrotToggleInd.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        BrainrotToggleLabel.TextColor3 = Color3.fromRGB(180, 255, 120)
        BrainrotToggleLabel.Text = "Brainrot: BẬT"
    else
        BrainrotToggle.ImageColor3 = Color3.fromRGB(60, 60, 80)
        BrainrotToggleInd.Position = UDim2.new(0, 3, 0.5, -9)
        BrainrotToggleInd.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        BrainrotToggleLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        BrainrotToggleLabel.Text = "Brainrot: TẮT"
    end
end

local animalOn = true
local function ToggleAnimal()
    animalOn = not animalOn
    Settings.AnimalEnabled = animalOn
    
    if animalOn then
        AnimalToggle.ImageColor3 = Color3.fromRGB(0, 200, 80)
        AnimalToggleInd.Position = UDim2.new(0, 29, 0.5, -9)
        AnimalToggleInd.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        AnimalToggleLabel.TextColor3 = Color3.fromRGB(180, 255, 120)
        AnimalToggleLabel.Text = "Animal: BẬT"
    else
        AnimalToggle.ImageColor3 = Color3.fromRGB(60, 60, 80)
        AnimalToggleInd.Position = UDim2.new(0, 3, 0.5, -9)
        AnimalToggleInd.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        AnimalToggleLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        AnimalToggleLabel.Text = "Animal: TẮT"
    end
end

-- Main toggle
local isOn = false
local function ToggleTeleport()
    isOn = not isOn
    Settings.Enabled = isOn
    
    if isOn then
        ToggleBtn.ImageColor3 = Color3.fromRGB(0, 200, 80)
        ToggleInd.Position = UDim2.new(0, 39, 0.5, -14)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ToggleLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
        StatusLabel.Text = "▶ ĐANG TELEPORT..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
        
        local currentIsland = GetCurrentIsland()
        if currentIsland then
            print("📍 Bắt đầu từ: " .. currentIsland)
        end
        
        -- Start brainrot/animal check loop
        coroutine.wrap(BrainrotAnimalCheckLoop)()
        -- Start main teleport loop
        coroutine.wrap(IslandTeleportLoop)()
    else
        ToggleBtn.ImageColor3 = Color3.fromRGB(60, 60, 80)
        ToggleInd.Position = UDim2.new(0, 3, 0.5, -14)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        ToggleLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        StatusLabel.Text = "⏹ Đã dừng"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
    end
    
    UpdateUI()
end

-- Connect events
ToggleBtn.MouseButton1Click:Connect(ToggleTeleport)
BrainrotToggle.MouseButton1Click:Connect(ToggleBrainrot)
AnimalToggle.MouseButton1Click:Connect(ToggleAnimal)

-- Cập nhật UI định kỳ
task.spawn(function()
    while task.wait(2) do
        if not Settings.Enabled then
            UpdateUI()
        end
    end
end)

task.wait(1)
UpdateUI()

