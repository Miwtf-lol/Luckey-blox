-- =====================
-- UI FUNCTIONS
-- =====================

local transformOn = true

local function UpdateUI()
    local islandName, displayText = DetectTransformation()
    
    if islandName then
        EntityStatus.Text = "👾 Entity: " .. (displayText or "Unknown")
        EntityStatus.TextColor3 = Color3.fromRGB(100, 255, 150)
        DetectedIsland.Text = "🏝 Đảo: " .. islandName
        DetectedIsland.TextColor3 = Color3.fromRGB(255, 200, 100)
        StatusTransform.Text = "🔄 Transform: ✅ " .. (displayText or "Unknown") .. " → " .. islandName
        StatusTransform.TextColor3 = Color3.fromRGB(100, 255, 150)
    else
        EntityStatus.Text = "👾 Entity: Không phát hiện"
        EntityStatus.TextColor3 = Color3.fromRGB(180, 180, 180)
        DetectedIsland.Text = "🏝 Đảo: Chưa xác định"
        DetectedIsland.TextColor3 = Color3.fromRGB(150, 150, 180)
        StatusTransform.Text = "🔄 Transform: ❌ Chưa phát hiện"
        StatusTransform.TextColor3 = Color3.fromRGB(120, 120, 150)
    end
    
    if Settings.Enabled then
        StatusLabel.Text = "▶ ĐANG CHẠY..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
        ToggleLabel.Text = "⏹ Dừng Teleport"
    else
        StatusLabel.Text = "⏹ Dừng"
        StatusLabel.TextColor3 = Color3.fromRGB(120, 120, 150)
        ToggleLabel.Text = "▶ Bắt đầu Teleport"
    end
end

-- Toggle Transform
local function ToggleTransform()
    transformOn = not transformOn
    Settings.AutoTPOnTransform = transformOn
    
    if transformOn then
        TransformToggle.ImageColor3 = Color3.fromRGB(0, 200, 80)
        TransformToggleInd.Position = UDim2.new(0, 29, 0.5, -9)
        TransformToggleInd.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        TransformToggleLabel.TextColor3 = Color3.fromRGB(180, 255, 120)
        TransformToggleLabel.Text = "Auto Transform TP: BẬT"
    else
        TransformToggle.ImageColor3 = Color3.fromRGB(60, 60, 80)
        TransformToggleInd.Position = UDim2.new(0, 3, 0.5, -9)
        TransformToggleInd.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        TransformToggleLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        TransformToggleLabel.Text = "Auto Transform TP: TẮT"
    end
end

-- Main Toggle
local isOn = false
local function ToggleMain()
    isOn = not isOn
    Settings.Enabled = isOn
    
    if isOn then
        ToggleBtn.ImageColor3 = Color3.fromRGB(0, 200, 80)
        ToggleInd.Position = UDim2.new(0, 39, 0.5, -14)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ToggleLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
        StatusLabel.Text = "▶ ĐANG CHẠY..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
        
        print("🚀 MIU Hub TP PRO khởi động...")
        
        -- Start transform detection loop
        coroutine.wrap(TransformDetectionLoop)()
        -- Start manual teleport loop
        coroutine.wrap(ManualTeleportLoop)()
    else
        ToggleBtn.ImageColor3 = Color3.fromRGB(60, 60, 80)
        ToggleInd.Position = UDim2.new(0, 3, 0.5, -14)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        ToggleLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        StatusLabel.Text = "⏹ Dừng"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        ToggleLabel.Text = "▶ Bắt đầu Teleport"
        
        print("⏹ MIU Hub TP PRO đã dừng")
    end
    
    UpdateUI()
end

-- Connect
ToggleBtn.MouseButton1Click:Connect(ToggleMain)
TransformToggle.MouseButton1Click:Connect(ToggleTransform)

-- UI Update loop
task.spawn(function()
    while task.wait(1) do
        pcall(UpdateUI)
    end
end)

task.wait(1)
UpdateUI()

-- Console output
print("=" .. string.rep("=", 55) .. "=")
print("  🏝 MIU Hub - Island Teleporter PRO")
print("=" .. string.rep("=", 55) .. "=")
print("")
print("  📋 DANH SÁCH ĐẢO & ENTITY:")
print("  ─────────────────────────────")
for i, islandName in ipairs(Settings.IslandNames) do
    print("  " .. i .. ". " .. islandName .. " → " .. table.concat(Settings.IslandEntities[islandName], ", "))
end
print("")
print("  🎯 CÁCH HOẠT ĐỘNG:")
print("  • Phát hiện biến hình Entity qua tên trên đầu")
print("  • Phát hiện qua: BillboardGui, Model name, DisplayName")
print("  • Phát hiện qua: Attributes, Accessories, Mesh, Animation")
print("  • Tự động TELEPORT đến đảo tương ứng với Entity")
print("")
print("  ✅ Kéo thả UI để di chuyển")
print("  ✅ Bật toggle để bắt đầu")
print("  ✅ Bật/Tắt Auto Transform TP riêng")
print("")
print("=" .. string.rep("=", 55) .. "=")

-- Global
_G.MIU_IslandTP = {
    Start = ToggleMain,
    Stop = function() 
        Settings.Enabled = false
        isOn = false
        ToggleBtn.ImageColor3 = Color3.fromRGB(60, 60, 80)
        ToggleInd.Position = UDim2.new(0, 3, 0.5, -14)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        ToggleLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        StatusLabel.Text = "⏹ Dừng"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        print("⏹ Đã dừng teleport")
    end,
    Status = function() return Settings.Enabled end,
    Detect = DetectTransformation,
    ToggleTransform = ToggleTransform,
    Settings = Settings
}
