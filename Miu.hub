-- ===== FUNCTIONS =====

function UpdateUI()
    if Settings.Minimized then return end
    
    local currentZone = GetCurrentZone()
    
    if currentZone then
        PosLabel.Text = "📍 Vị trí: " .. currentZone
        PosLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
        
        local zones = GetZonesToTeleport()
        if #zones > 0 then
            RouteLabel.Text = "Route: " .. table.concat(zones, " → ") .. " → ✅ Common"
            RouteLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        else
            RouteLabel.Text = "✅ Đã ở Common!"
            RouteLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    else
        PosLabel.Text = "📍 Không xác định (dùng toạ độ mặc định)"
        PosLabel.TextColor3 = Color3.fromRGB(255, 180, 100)
        RouteLabel.Text = "Teleport từ Celestial → Common"
        RouteLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
    end
    
    if Settings.Enabled then
        StatusLabel.Text = "▶ ĐANG TELEPORT..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
        StatusFill:TweenSize(UDim2.new(1, 0, 1, 0), Enum.EasingDirection.In, Enum.EasingStyle.Linear, 0.5, true)
        ToggleText.Text = "⏹ Dừng"
        ToggleText.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        StatusLabel.Text = "⏹ Sẵn sàng"
        StatusLabel.TextColor3 = Color3.fromRGB(120, 120, 150)
        StatusFill:TweenSize(UDim2.new(0, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
        ToggleText.Text = "▶ Bắt đầu"
        ToggleText.TextColor3 = Color3.fromRGB(160, 160, 160)
    end
end

-- Toggle teleport
function ToggleTeleport()
    if Settings.Minimized then
        ToggleMinimize()
        return
    end
    
    Settings.Enabled = not Settings.Enabled
    
    if Settings.Enabled then
        ToggleBtn.ImageColor3 = Color3.fromRGB(0, 200, 80)
        ToggleInd.Position = UDim2.new(0, 37, 0.5, -15)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(50, 255, 100)
        UpdateUI()
        
        -- Start teleport loop
        task.spawn(StartTeleport)
    else
        ToggleBtn.ImageColor3 = Color3.fromRGB(50, 50, 70)
        ToggleInd.Position = UDim2.new(0, 3, 0.5, -15)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(160, 160, 160)
        UpdateUI()
    end
end

-- Minimize/Maximize
function ToggleMinimize()
    Settings.Minimized = not Settings.Minimized
    
    if Settings.Minimized then
        Content.Visible = false
        Header.Visible = false
        Main.Size = UDim2.new(0, 50, 0, 50)
        Main:TweenSize(UDim2.new(0, 50, 0, 50), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
        MinIcon.Visible = true
    else
        MinIcon.Visible = false
        Content.Visible = true
        Header.Visible = true
        Main:TweenSize(UDim2.new(0, 300, 0, 220), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
        UpdateUI()
    end
end

-- Connections
ToggleBtn.MouseButton1Click:Connect(ToggleTeleport)

MinBtn.MouseButton1Click:Connect(ToggleMinimize)

