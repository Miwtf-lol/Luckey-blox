--[[
    MIU Hub - Island Teleporter V2
    - Kéo thả UI
    - Thu nhỏ thành ô vuông
    - Teleport nhanh hơn
    - Chống sóng đánh chết
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

-- Settings
local Settings = {
    Enabled = false,
    TeleportDelay = 0.3, -- Delay nhanh hơn (0.3s thay vì 1.5s)
    CurrentIsland = nil,
    Minimized = false
}

-- Danh sách đảo
local IslandOrder = {
    "Celestial",
    "OG",
    "Hacked",
    "Divine",
    "Secret",
    "Godly",
    "Mythic",
    "Legend",
    "Epic",
    "Rare",
    "Common"
}

-- Từ khóa mở rộng
local IslandKeywords = {
    Celestial = {"CELESTIAL", "CELEST"},
    OG = {"OG", "ORIGINAL"},
    Hacked = {"HACKED", "HACK"},
    Divine = {"DIVINE", "DIVIN"},
    Secret = {"SECRET"},
    Godly = {"GODLY", "GOD"},
    Mythic = {"MYTHIC", "MYTH"},
    Legend = {"LEGEND", "LEGENDARY"},
    Epic = {"EPIC"},
    Rare = {"RARE"},
    Common = {"COMMON", "COMMOM", "SAFE", "SPAWN", "LOBBY"}
}

-- Hàm tìm đảo
local function FindIsland(islandName)
    local keywords = IslandKeywords[islandName] or {islandName:upper()}
    
    for _, v in pairs(workspace:GetDescendants()) do
        local name = (v.Name or ""):upper()
        for _, kw in pairs(keywords) do
            if name:find(kw) then
                if v:IsA("BasePart") then
                    return v
                elseif v:IsA("Model") then
                    local pp = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                    if pp then return pp end
                    local biggestPart = nil
                    local biggestSize = 0
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") and (part.Size.X * part.Size.Y * part.Size.Z) > biggestSize then
                            biggestSize = part.Size.X * part.Size.Y * part.Size.Z
                            biggestPart = part
                        end
                    end
                    if biggestPart then return biggestPart end
                end
            end
        end
    end
    return nil
end

-- Hàm xác định vị trí hiện tại
local function GetCurrentIsland()
    local char = Player.Character
    if not char then return nil end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local pos = hrp.Position
    local closestIsland = nil
    local closestDist = math.huge
    
    for _, islandName in ipairs(IslandOrder) do
        local islandPart = FindIsland(islandName)
        if islandPart then
            local dist = (pos - islandPart.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestIsland = islandName
            end
        end
    end
    
    if closestDist < 150 then
        return closestIsland
    end
    return nil
end

-- Hàm teleport nhanh
local function TeleportToIsland(islandName)
    pcall(function()
        local islandPart = FindIsland(islandName)
        if not islandPart then return false end
        
        local char = Player.Character
        if not char then return false end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        -- Teleport ngay lập tức thay vì tween
        local targetPos = islandPart.Position + Vector3.new(0, islandPart.Size.Y / 2 + 8, 0)
        hrp.CFrame = CFrame.new(targetPos)
        
        -- Reset velocity để tránh bị sóng đánh
        local bv = hrp:FindFirstChildOfClass("BodyVelocity")
        if bv then bv:Destroy() end
        
        -- Thêm trọng lực tạm thời để rơi nhanh
        hrp.Velocity = Vector3.new(0, -10, 0)
        
        return true
    end)
    return false
end

-- Hàm lấy danh sách đảo cần tele
local function GetIslandsToTeleport()
    local currentIsland = GetCurrentIsland()
    if not currentIsland then
        return IslandOrder
    end
    
    Settings.CurrentIsland = currentIsland
    
    local currentIndex = nil
    for i, name in ipairs(IslandOrder) do
        if name == currentIsland then
            currentIndex = i
            break
        end
    end
    
    if not currentIndex then
        return IslandOrder
    end
    
    local islandsToTeleport = {}
    for i = currentIndex, #IslandOrder do
        table.insert(islandsToTeleport, IslandOrder[i])
    end
    
    if #islandsToTeleport > 1 then
        table.remove(islandsToTeleport, 1)
    end
    
    return islandsToTeleport
end

-- Main loop - Teleport nhanh hơn
local function IslandTeleportLoop()
    while Settings.Enabled and task.wait(Settings.TeleportDelay) do
        pcall(function()
            local islands = GetIslandsToTeleport()
            
            if #islands == 0 then
                print("✅ Đã ở Common!")
                Settings.Enabled = false
                UpdateUI()
                return
            end
            
            for _, islandName in ipairs(islands) do
                if not Settings.Enabled then break end
                
                TeleportToIsland(islandName)
                task.wait(Settings.TeleportDelay)
            end
            
            if Settings.Enabled then
                print("✅ Hoàn thành!")
                Settings.Enabled = false
                UpdateUI()
            end
        end)
    end
end

