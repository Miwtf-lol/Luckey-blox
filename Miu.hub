-- SETTINGS
getgenv().SpeedValue = 40
getgenv().SpeedOn = false
local DefaultSpeed = 16

local player = game.Players.LocalPlayer

-- GUI
local ScreenGui = Instance.new("ScreenGui")
local Frame = Instance.new("Frame")
local Plus = Instance.new("TextButton")
local Minus = Instance.new("TextButton")
local Toggle = Instance.new("TextButton")
local Label = Instance.new("TextLabel")

ScreenGui.Parent = game.CoreGui

Frame.Parent = ScreenGui
Frame.BackgroundColor3 = Color3.fromRGB(255, 105, 180)
Frame.BackgroundTransparency = 0.2
Frame.Size = UDim2.new(0, 220, 0, 130)
Frame.Position = UDim2.new(0.4, 0, 0.4, 0)
Frame.Active = true
Frame.Draggable = true

-- Label hiển thị speed
Label.Parent = Frame
Label.Size = UDim2.new(1, 0, 0.3, 0)
Label.Text = "Speed: "..getgenv().SpeedValue
Label.BackgroundTransparency = 1
Label.TextScaled = true

-- Nút +
Plus.Parent = Frame
Plus.Size = UDim2.new(0.5, 0, 0.3, 0)
Plus.Position = UDim2.new(0.5, 0, 0.3, 0)
Plus.Text = "+"
Plus.TextScaled = true

-- Nút -
Minus.Parent = Frame
Minus.Size = UDim2.new(0.5, 0, 0.3, 0)
Minus.Position = UDim2.new(0, 0, 0.3, 0)
Minus.Text = "-"
Minus.TextScaled = true

-- Nút ON/OFF
Toggle.Parent = Frame
Toggle.Size = UDim2.new(1, 0, 0.4, 0)
Toggle.Position = UDim2.new(0, 0, 0.6, 0)
Toggle.Text = "OFF"
Toggle.TextScaled = true
Toggle.BackgroundColor3 = Color3.fromRGB(200, 0, 0)

-- Tăng speed
Plus.MouseButton1Click:Connect(function()
    getgenv().SpeedValue = getgenv().SpeedValue + 5
    Label.Text = "Speed: "..getgenv().SpeedValue
end)

-- Giảm speed
Minus.MouseButton1Click:Connect(function()
    getgenv().SpeedValue = getgenv().SpeedValue - 5
    if getgenv().SpeedValue < 16 then
        getgenv().SpeedValue = 16
    end
    Label.Text = "Speed: "..getgenv().SpeedValue
end)

-- Toggle ON/OFF
Toggle.MouseButton1Click:Connect(function()
    getgenv().SpeedOn = not getgenv().SpeedOn

    if getgenv().SpeedOn then
        Toggle.Text = "ON"
        Toggle.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    else
        Toggle.Text = "OFF"
        Toggle.BackgroundColor3 = Color3.fromRGB(200, 0, 0)

        -- trả về speed mặc định
        pcall(function()
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = DefaultSpeed
            end
        end)
    end
end)

-- Loop speed
task.spawn(function()
    while task.wait(0.2) do
        if getgenv().SpeedOn then
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("Humanoid") then
                    char.Humanoid.WalkSpeed = getgenv().SpeedValue
                end
            end)
        end
    end
end)

-- Khi respawn
player.CharacterAdded:Connect(function(char)
    task.wait(1)
    if getgenv().SpeedOn then
        char:WaitForChild("Humanoid").WalkSpeed = getgenv().SpeedValue
    else
        char:WaitForChild("Humanoid").WalkSpeed = DefaultSpeed
    end
end)
