-- =====================
-- NEW: Brainrot & Animal Detection
-- =====================

-- Từ khóa phát hiện brainrot
local BrainrotKeywords = {
    "BRAINROT", "BRAIN_ROT", "BRAINROTED", "ROTTEN", 
    "ZOMBIE", "UNDEAD", "INFECTED", "MUTATED",
    "CORRUPTED", "CURSED", "BRAIN", "ROT"
}

-- Từ khóa phát hiện động vật
local AnimalKeywords = {
    "ANIMAL", "BEAST", "FURRY", "CAT", "DOG", "WOLF",
    "FOX", "RABBIT", "BUNNY", "BIRD", "CHICKEN", "COW",
    "PIG", "SHEEP", "HORSE", "DRAGON", "SNAKE", "FISH",
    "SHARK", "TIGER", "LION", "BEAR", "PANDA", "MONKEY",
    "APE", "FROG", "DUCK", "GOOSE"
}

-- Kiểm tra xem nhân vật có đang là brainrot không
local function IsBrainrot()
    local char = Player.Character
    if not char then return false end
    
    -- Kiểm tra Humanoid
    local humanoid = char:FindFirstChildWhichIsA("Humanoid")
    if humanoid then
        local displayName = humanoid.DisplayName or ""
        if displayName:upper():find("BRAINROT") or displayName:upper():find("ZOMBIE") then
            return true
        end
    end
    
    -- Kiểm tra tên model
    local name = char.Name:upper()
    for _, kw in ipairs(BrainrotKeywords) do
        if name:find(kw) then
            return true
        end
    end
    
    -- Kiểm tra các attribute
    local attrs = char:GetAttributes()
    for key, val in pairs(attrs) do
        local keyStr = tostring(key):upper()
        local valStr = tostring(val):upper()
        if keyStr:find("BRAIN") or keyStr:find("ROT") or keyStr:find("ZOMBIE") then
            return true
        end
        if valStr:find("BRAINROT") or valStr:find("ZOMBIE") or valStr:find("INFECTED") then
            return true
        end
    end
    
    -- Kiểm tra accessories/hats (thường dùng để biến hình)
    for _, child in pairs(char:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Hat") or child:IsA("Tool") then
            local childName = child.Name:upper()
            local handle = child:FindFirstChild("Handle")
            local handleName = handle and handle.Name:upper() or ""
            
            for _, kw in ipairs(BrainrotKeywords) do
                if childName:find(kw) or handleName:find(kw) then
                    return true
                end
            end
        end
    end
    
    -- Kiểm tra BodyEffects/effects (thường có trong game có hệ thống biến hình)
    local effects = char:FindFirstChild("BodyEffects") or char:FindFirstChild("Effects")
    if effects then
        for _, child in pairs(effects:GetChildren()) do
            local n = child.Name:upper()
            for _, kw in ipairs(BrainrotKeywords) do
                if n:find(kw) then return true end
            end
        end
    end
    
    -- Kiểm qua RemoteEvent (nếu game có system gửi sự kiện biến hình)
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
            local rName = remote.Name:upper()
            if rName:find("BRAIN") or rName:find("TRANSFORM") or rName:find("MORPH") then
                -- Game có hệ thống biến hình - kiểm tra thêm
            end
        end
    end
    
    return false
end

-- Kiểm tra xem nhân vật có đang là động vật không
local function IsAnimal()
    local char = Player.Character
    if not char then return false end
    
    -- Kiểm tra Humanoid.DisplayName
    local humanoid = char:FindFirstChildWhichIsA("Humanoid")
    if humanoid then
        local displayName = humanoid.DisplayName or ""
        for _, kw in ipairs(AnimalKeywords) do
            if displayName:upper():find(kw) then
                return true
            end
        end
    end
    
    -- Kiểm tra tên model nhân vật
    local name = char.Name:upper()
    for _, kw in ipairs(AnimalKeywords) do
        if name:find(kw) then
            return true
        end
    end
    
    -- Kiểm tra attributes
    local attrs = char:GetAttributes()
    for key, val in pairs(attrs) do
        local keyStr = tostring(key):upper()
        local valStr = tostring(val):upper()
        if keyStr:find("MORPH") or keyStr:find("ANIMAL") or keyStr:find("TRANSFORM") then
            return true
        end
        if valStr:find("ANIMAL") or valStr:find("MORPH") or valStr:find("BEAST") then
            return true
        end
    end
    
    -- Kiểm tra accessories
    for _, child in pairs(char:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Tool") then
            local childName = child.Name:upper()
            local handle = child:FindFirstChild("Handle")
            local handleName = handle and handle.Name:upper() or ""
            
            for _, kw in ipairs(AnimalKeywords) do
                if childName:find(kw) or handleName:find(kw) then
                    return true
                end
            end
        end
    end
    
    -- Kiểm tra MeshParts/SpecialMesh (thường dùng cho morph)
    for _, desc in pairs(char:GetDescendants()) do
        if desc:IsA("MeshPart") or desc:IsA("SpecialMesh") or desc:IsA("BlockMesh") then
            local meshName = (desc.Name .. " " .. (desc.MeshId or "")):upper()
            for _, kw in ipairs(AnimalKeywords) do
                if meshName:find(kw) then
                    return true
                end
            end
            -- Kiểm tra MeshId URL
            local meshId = (desc:IsA("SpecialMesh") and desc.MeshId) or (desc:IsA("MeshPart") and desc.MeshId) or ""
            if meshId ~= "" then
                for _, kw in ipairs(AnimalKeywords) do
                    if meshId:upper():find(kw) then
                        return true
                    end
                end
            end
        end
    end
    
    -- Kiểm tra AnimationTracks đang chạy (animation động vật)
    if humanoid then
        local animator = humanoid:FindFirstChildWhichIsA("Animator")
        if animator then
            for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                local animName = (track.Animation and track.Animation.Name or ""):upper()
                local animId = (track.Animation and track.Animation.AnimationId or ""):upper()
                for _, kw in ipairs(AnimalKeywords) do
                    if animName:find(kw) or animId:find(kw) then
                        return true
                    end
                end
            end
        end
    end
    
    -- Kiểm tra qua RemoteSpy style (nếu có event biến hình)
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local rName = remote.Name:upper()
            if rName:find("MORPH") or rName:find("ANIMAL") or rName:find("TRANSFORM") then
                return true  -- Game có hệ thống morph -> khả năng cao đang là animal
            end
        end
    end
    
    return false
end

-- Hàm teleport khi phát hiện brainrot/animal
local function QuickTeleportToIsland(islandName)
    pcall(function()
        local islandPart = FindIsland(islandName)
        if not islandPart then 
            print("⚠️ [AutoTP] Không tìm thấy đảo: " .. islandName)
            return false 
        end
        
        local char = Player.Character
        if not char then return false end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        local targetPos = islandPart.Position + Vector3.new(0, islandPart.Size.Y / 2 + 5, 0)
        hrp.CFrame = CFrame.new(targetPos)
        
        print("✅ [AutoTP] Đã tele đến " .. islandName)
        return true
    end)
end

-- Vòng lặp kiểm tra brainrot & animal
local function BrainrotAnimalCheckLoop()
    while task.wait(Settings.CheckInterval) do
        pcall(function()
            if not Settings.Enabled then return end
            
            local isBrainrot = IsBrainrot()
            local isAnimal = IsAnimal()
            
            -- Brainrot detection
            if Settings.BrainrotEnabled and isBrainrot and not Settings.LastState.IsBrainrot then
                print("🧠 [Brainrot] Phát hiện biến thành brainrot! Đang tele...")
                QuickTeleportToIsland(Settings.BrainrotTeleportTarget)
            end
            
            -- Animal detection
            if Settings.AnimalEnabled and isAnimal and not Settings.LastState.IsAnimal then
                print("🐾 [Animal] Phát hiện biến thành động vật! Đang tele...")
                QuickTeleportToIsland(Settings.AnimalTeleportTarget)
            end
            
            -- Cập nhật trạng thái
            Settings.LastState.IsBrainrot = isBrainrot
            Settings.LastState.IsAnimal = isAnimal
        end)
    end
end

-- =====================
-- Original Functions (giữ nguyên)
-- =====================

-- Hàm tìm đảo theo tên
local function FindIsland(islandName)
    local keywords = IslandKeywords[islandName] or {islandName:upper()}
    
    for _, v in pairs(workspace:GetDescendants()) do
        local name = (v.Name or ""):upper()
        for _, kw in pairs(keywords) do
            if name:find(kw) then
                if v:IsA("BasePart") then
                    return v
                elseif v:IsA("Model") then
                    local pp = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                    if pp then return pp end
                    local biggestPart = nil
                    local biggestSize = 0
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") and (part.Size.X * part.Size.Y * part.Size.Z) > biggestSize then
                            biggestSize = part.Size.X * part.Size.Y * part.Size.Z
                            biggestPart = part
                        end
                    end
                    if biggestPart then return biggestPart end
                end
            end
        end
    end
    return nil
end

-- Hàm xác định vị trí hiện tại
local function GetCurrentIsland()
    local char = Player.Character
    if not char then return nil end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local pos = hrp.Position
    local closestIsland = nil
    local closestDist = math.huge
    
    for _, islandName in ipairs(IslandOrder) do
        local islandPart = FindIsland(islandName)
        if islandPart then
            local dist = (pos - islandPart.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestIsland = islandName
            end
        end
    end
    
    if closestDist < 100 then
        return closestIsland
    end
    return nil
end

-- Hàm teleport
local function TeleportToIsland(islandName)
    pcall(function()
        local islandPart = FindIsland(islandName)
        if not islandPart then 
            print("⚠️ Không tìm thấy đảo: " .. islandName)
            return false 
        end
        
        local char = Player.Character
        if not char then return false end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        local targetPos = islandPart.Position + Vector3.new(0, islandPart.Size.Y / 2 + 5, 0)
        hrp.CFrame = CFrame.new(targetPos)
        
        print("✅ Teleported to: " .. islandName)
        return true
    end)
    return false
end

-- Hàm lấy danh sách đảo cần tele
local function GetIslandsToTeleport()
    local currentIsland = GetCurrentIsland()
    if not currentIsland then
        print("⚠️ Không xác định được vị trí, bắt đầu từ đầu")
        return IslandOrder
    end
    
    Settings.CurrentIsland = currentIsland
    print("📍 Vị trí hiện tại: " .. currentIsland)
    
    local currentIndex = nil
    for i, name in ipairs(IslandOrder) do
        if name == currentIsland then
            currentIndex = i
            break
        end
    end
    
    if not currentIndex then
        return IslandOrder
    end
    
    local islandsToTeleport = {}
    for i = currentIndex, #IslandOrder do
        table.insert(islandsToTeleport, IslandOrder[i])
    end
    
    if #islandsToTeleport > 1 then
        table.remove(islandsToTeleport, 1)
    end
    
    return islandsToTeleport
end

-- Main loop
local function IslandTeleportLoop()
    while Settings.Enabled and task.wait(Settings.TeleportDelay) do
        pcall(function()
            local islands = GetIslandsToTeleport()
            
            if #islands == 0 then
                print("✅ Đã ở đảo thấp nhất! (Common)")
                Settings.Enabled = false
                return
            end
            
            print("🔄 Đang tele: " .. table.concat(islands, " → "))
            
            for _, islandName in ipairs(islands) do
                if not Settings.Enabled then break end
                
                local success = TeleportToIsland(islandName)
                if success then
                    task.wait(Settings.TeleportDelay)
                else
                    local found = false
                    for _, kw in pairs(IslandKeywords[islandName] or {}) do
                        for _, v in pairs(workspace:GetDescendants()) do
                            if v:IsA("BasePart") and (v.Name:upper():find(kw) or (v.Parent and v.Parent.Name:upper():find(kw))) then
                                local targetPos = v.Position + Vector3.new(0, v.Size.Y / 2 + 5, 0)
                                local char = Player.Character
                                if char and char:FindFirstChild("HumanoidRootPart") then
                                    char.HumanoidRootPart.CFrame = CFrame.new(targetPos)
                                    print("✅ Teleported to: " .. islandName .. " (alternative)")
                                    found = true
                                end
                                break
                            end
                        end
                        if found then break end
                    end
                    task.wait(Settings.TeleportDelay)
                end
            end
            
            if Settings.Enabled then
                print("✅ Hoàn thành! Đã tele đến Common")
                Settings.Enabled = false
                if UpdateUI then UpdateUI() end
            end
        end)
    end
end

