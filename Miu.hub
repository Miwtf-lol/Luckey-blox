--[[
    MIU Hub - Island Teleporter V2 (FIXED)
    - Kéo thả UI
    - Thu nhỏ ô vuông
    - Teleport nhanh hơn
    - Sửa toàn bộ lỗi không chạy
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

-- Settings
local Settings = {
    Enabled = false,
    TeleportDelay = 0.3,
    CurrentIsland = nil,
    Minimized = false
}

local IslandOrder = {
    "Celestial","OG","Hacked","Divine","Secret",
    "Godly","Mythic","Legend","Epic","Rare","Common"
}

local IslandKeywords = {
    Celestial = {"CELESTIAL","CELEST"},
    OG = {"OG","ORIGINAL"},
    Hacked = {"HACKED","HACK"},
    Divine = {"DIVINE","DIVIN"},
    Secret = {"SECRET"},
    Godly = {"GODLY","GOD"},
    Mythic = {"MYTHIC","MYTH"},
    Legend = {"LEGEND","LEGENDARY"},
    Epic = {"EPIC"},
    Rare = {"RARE"},
    Common = {"COMMON","SPAWN","LOBBY"}
}

-- FIND ISLAND
local function FindIsland(name)
    local keywords = IslandKeywords[name] or {name:upper()}

    for _,v in pairs(workspace:GetDescendants()) do
        local n = (v.Name or ""):upper()
        for _,kw in pairs(keywords) do
            if n:find(kw) then
                if v:IsA("BasePart") then
                    return v
                elseif v:IsA("Model") then
                    return v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                end
            end
        end
    end
    return nil
end

-- CURRENT ISLAND
local function GetCurrentIsland()
    local char = Player.Character
    if not char then return nil end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local pos = hrp.Position
    local closest, dist = nil, math.huge

    for _,name in ipairs(IslandOrder) do
        local part = FindIsland(name)
        if part then
            local d = (pos - part.Position).Magnitude
            if d < dist then
                dist = d
                closest = name
            end
        end
    end

    if dist < 150 then
        return closest
    end
    return nil
end

-- TELEPORT
local function TeleportToIsland(name)
    pcall(function()
        local part = FindIsland(name)
        if not part then return end

        local char = Player.Character
        if not char then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        hrp.CFrame = CFrame.new(part.Position + Vector3.new(0,10,0))
        hrp.Velocity = Vector3.zero
    end)
end

-- ROUTE
local function GetRoute()
    local current = GetCurrentIsland()
    if not current then return IslandOrder end

    local index = table.find(IslandOrder, current)
    if not index then return IslandOrder end

    local list = {}
    for i = index, #IslandOrder do
        table.insert(list, IslandOrder[i])
    end

    table.remove(list, 1)
    return list
end

-- LOOP
local function TeleportLoop()
    while Settings.Enabled do
        task.wait(Settings.TeleportDelay)

        local route = GetRoute()
        if #route == 0 then
            Settings.Enabled = false
            break
        end

        for _,v in ipairs(route) do
            if not Settings.Enabled then break end
            TeleportToIsland(v)
            task.wait(Settings.TeleportDelay)
        end
    end
end

-- GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

local Main = Instance.new("Frame")
Main.Size = UDim2.new(0,320,0,240)
Main.Position = UDim2.new(0.5,-160,0.5,-120)
Main.BackgroundColor3 = Color3.fromRGB(20,20,30)
Main.Parent = ScreenGui
Main.Active = true

Instance.new("UICorner", Main)

-- DRAG FIX
local dragging, dragStart, startPos = false, nil, nil

Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- HEADER
local Header = Instance.new("TextLabel")
Header.Size = UDim2.new(1,0,0,35)
Header.Text = "MIU Teleporter FIXED"
Header.BackgroundColor3 = Color3.fromRGB(35,35,55)
Header.TextColor3 = Color3.fromRGB(255,255,255)
Header.Parent = Main

-- BUTTON
local Toggle = Instance.new("TextButton")
Toggle.Size = UDim2.new(0,120,0,40)
Toggle.Position = UDim2.new(0,10,0,50)
Toggle.Text = "START"
Toggle.Parent = Main

Toggle.MouseButton1Click:Connect(function()
    Settings.Enabled = not Settings.Enabled

    if Settings.Enabled then
        Toggle.Text = "STOP"
        coroutine.wrap(TeleportLoop)()
    else
        Toggle.Text = "START"
    end
end)

-- MINIMIZE FIX
local MinimizedIcon = Instance.new("TextButton")
MinimizedIcon.Size = UDim2.new(0,50,0,50)
MinimizedIcon.Position = UDim2.new(0,10,0,10)
MinimizedIcon.Text = "UI"
MinimizedIcon.Visible = false
MinimizedIcon.Parent = ScreenGui

MinimizedIcon.MouseButton1Click:Connect(function()
    Main.Visible = true
    MinimizedIcon.Visible = false
end)

local MinBtn = Instance.new("TextButton")
MinBtn.Size = UDim2.new(0,30,0,30)
MinBtn.Position = UDim2.new(1,-35,0,5)
MinBtn.Text = "-"
MinBtn.Parent = Main

MinBtn.MouseButton1Click:Connect(function()
    Main.Visible = false
    MinimizedIcon.Visible = true
end)

print("MIU HUB FIXED LOADED")
