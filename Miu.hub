-- =====================
-- TOGGLES
-- =====================
local Toggles = {
    PerfectKick = false,
    BonusTrain = false,
    CollectCash = false,
    UpgradeAll = false,
    BuySpeed = false,
    AutoRebirth = false
}

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- =====================
-- CLICK FUNCTION
-- =====================
local function Click(obj)
    if not obj then return end
    
    if obj:IsA("TextButton") or obj:IsA("ImageButton") then
        pcall(function()
            obj:Activate()
        end)
        
    elseif obj:IsA("ClickDetector") then
        pcall(function()
            fireclickdetector(obj)
        end)
        
    elseif obj:IsA("ProximityPrompt") then
        pcall(function()
            fireproximityprompt(obj)
        end)
    end
end

-- =====================
-- PERFECT KICK
-- =====================
local function PerfectKickLoop()
    while Toggles.PerfectKick do
        task.wait(0.6)

        pcall(function()
            for _, v in pairs(PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") or v:IsA("ImageButton") then
                    local txt = (v.Text or ""):lower()
                    if txt:find("kick") or txt:find("claim") then
                        Click(v)
                    end
                end
            end

            for _, v in pairs(workspace:GetDescendants()) do
                Click(v:FindFirstChildOfClass("ClickDetector"))
                Click(v:FindFirstChildOfClass("ProximityPrompt"))
            end
        end)
    end
end

-- =====================
-- COLLECT CASH
-- =====================
local function CollectCashLoop()
    while Toggles.CollectCash do
        task.wait(0.7)

        pcall(function()
            for _, v in pairs(workspace:GetDescendants()) do
                local name = v.Name:lower()
                if name:find("coin") or name:find("cash") then
                    Click(v:FindFirstChildOfClass("ClickDetector"))
                    Click(v:FindFirstChildOfClass("ProximityPrompt"))
                end
            end

            for _, v in pairs(PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") or v:IsA("ImageButton") then
                    local txt = (v.Text or ""):lower()
                    if txt:find("collect") or txt:find("claim") then
                        Click(v)
                    end
                end
            end
        end)
    end
end

-- =====================
-- UPGRADE ALL
-- =====================
local function UpgradeAllLoop()
    while Toggles.UpgradeAll do
        task.wait(1)

        pcall(function()
            for _, v in pairs(PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") or v:IsA("ImageButton") then
                    local txt = (v.Text or ""):lower()
                    
                    if (txt:find("upgrade") or txt:find("buy")) and not txt:find("speed") then
                        Click(v)
                        task.wait(0.1)
                    end
                end
            end
        end)
    end
end

-- =====================
-- BUY SPEED
-- =====================
local function BuySpeedLoop()
    while Toggles.BuySpeed do
        task.wait(1)

        pcall(function()
            for _, v in pairs(PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") or v:IsA("ImageButton") then
                    local txt = (v.Text or ""):lower()
                    
                    if txt:find("speed") and (txt:find("buy") or txt:find("upgrade")) then
                        Click(v)
                    end
                end
            end
        end)
    end
end

-- =====================
-- AUTO REBIRTH
-- =====================
local function AutoRebirthLoop()
    while Toggles.AutoRebirth do
        task.wait(2)

        pcall(function()
            for _, v in pairs(PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") or v:IsA("ImageButton") then
                    local txt = (v.Text or ""):lower()
                    
                    if txt:find("rebirth") or txt:find("reset") then
                        Click(v)
                    end
                end
            end
        end)
    end
end

-- =====================
-- BONUS TRAIN
-- =====================
local function BonusTrainLoop()
    while Toggles.BonusTrain do
        task.wait(1.5)

        pcall(function()
            for _, v in pairs(workspace:GetDescendants()) do
                local name = v.Name:lower()
                
                if name:find("train") or name:find("bonus") then
                    Click(v:FindFirstChildOfClass("ClickDetector"))
                    Click(v:FindFirstChildOfClass("ProximityPrompt"))
                end
            end

            for _, v in pairs(PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") or v:IsA("ImageButton") then
                    local txt = (v.Text or ""):lower()
                    
                    if txt:find("bonus") or txt:find("reward") then
                        Click(v)
                    end
                end
            end
        end)
    end
end

-- =====================
-- GUI + DRAG
-- =====================
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)

local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0, 300, 0, 300)
Frame.Position = UDim2.new(0.5, -150, 0.5, -150)
Frame.BackgroundColor3 = Color3.fromRGB(15,15,15)
Frame.Active = true

Instance.new("UICorner", Frame).CornerRadius = UDim.new(0,10)

local Title = Instance.new("TextLabel", Frame)
Title.Size = UDim2.new(1,0,0,40)
Title.BackgroundColor3 = Color3.fromRGB(10,10,10)
Title.Text = "KICK A LUCKY BLOCK"
Title.TextColor3 = Color3.fromRGB(255,255,255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 18

-- DRAG
local UIS = game:GetService("UserInputService")
local dragging, dragInput, mousePos, framePos

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        mousePos = input.Position
        framePos = Frame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging then
        local delta = input.Position - mousePos
        Frame.Position = UDim2.new(
            framePos.X.Scale,
            framePos.X.Offset + delta.X,
            framePos.Y.Scale,
            framePos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function()
    dragging = false
end)

-- TOGGLE BUTTON
local function MakeToggle(text, y, name, func)
    local label = Instance.new("TextLabel", Frame)
    label.Size = UDim2.new(0.7,0,0,40)
    label.Position = UDim2.new(0,10,0,y)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left

    local box = Instance.new("TextButton", Frame)
    box.Size = UDim2.new(0,30,0,30)
    box.Position = UDim2.new(1,-40,0,y+5)
    box.BackgroundColor3 = Color3.fromRGB(40,40,40)
    box.Text = ""

    local on = false

    box.MouseButton1Click:Connect(function()
        on = not on
        Toggles[name] = on
        box.BackgroundColor3 = on and Color3.fromRGB(0,200,100) or Color3.fromRGB(40,40,40)

        if on then
            task.spawn(func)
        end
    end)
end

MakeToggle("Perfect Kick & Claim", 40, "PerfectKick", PerfectKickLoop)
MakeToggle("Bonus Train", 80, "BonusTrain", BonusTrainLoop)
MakeToggle("Collect Cash", 120, "CollectCash", CollectCashLoop)
MakeToggle("Upgrade All", 160, "UpgradeAll", UpgradeAllLoop)
MakeToggle("Buy Speed", 200, "BuySpeed", BuySpeedLoop)
MakeToggle("Auto Rebirth", 240, "AutoRebirth", AutoRebirthLoop)
