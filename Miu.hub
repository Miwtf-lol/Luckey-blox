-- Island/Entity list
local YPos = 78
local IslandLabels = {}

for i, islandName in ipairs(Settings.IslandNames) do
    -- Màu sắc gradient từ xanh (Common) đến tím/tím đỏ (Celestial)
    local color
    if islandName == "Common" then color = Color3.fromRGB(150, 255, 150)
    elseif islandName == "Rare" then color = Color3.fromRGB(100, 200, 255)
    elseif islandName == "Epic" then color = Color3.fromRGB(180, 100, 255)
    elseif islandName == "Legend" then color = Color3.fromRGB(255, 200, 50)
    elseif islandName == "Mythic" then color = Color3.fromRGB(255, 80, 200)
    elseif islandName == "Godly" then color = Color3.fromRGB(255, 100, 50)
    elseif islandName == "Secret" then color = Color3.fromRGB(200, 50, 255)
    elseif islandName == "Hacked" then color = Color3.fromRGB(0, 255, 100)
    elseif islandName == "OG" then color = Color3.fromRGB(255, 50, 50)
    elseif islandName == "Celestial" then color = Color3.fromRGB(255, 255, 0)
    end
    
    local islandLabel = Instance.new("TextLabel")
    islandLabel.Size = UDim2.new(1, -10, 0, 16)
    islandLabel.Position = UDim2.new(0, 10, 0, YPos)
    islandLabel.BackgroundTransparency = 1
    islandLabel.Text = islandName .. " → " .. table.concat(Settings.IslandEntities[islandName], ", ")
    islandLabel.TextColor3 = color
    islandLabel.TextSize = 10
    islandLabel.Font = Enum.Font.GothamSemibold
    islandLabel.TextXAlignment = Enum.TextXAlignment.Left
    islandLabel.TextTruncate = Enum.TextTruncate.AtEnd
    islandLabel.Parent = Content
    
    IslandLabels[islandName] = islandLabel
    YPos = YPos + 18
end

