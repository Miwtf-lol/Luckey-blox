-- ===== TOGGLE FUNCTION =====
local isOn = false
local function Toggle()
    isOn = not isOn
    Settings.Enabled = isOn
    
    if isOn then
        ToggleBtn.ImageColor3 = Color3.fromRGB(0, 200, 80)
        ToggleInd.Position = UDim2.new(0, 39, 0.5, -13)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        StatusText.Text = "▶ ON"
        StatusText.TextColor3 = Color3.fromRGB(0, 255, 120)
        InfoText.Text = "✓ Auto TP → COMMON (đang chạy)"
        InfoText.TextColor3 = Color3.fromRGB(0, 255, 120)
        ZoneText.TextColor3 = Color3.fromRGB(0, 255, 120)
        
        coroutine.wrap(AutoTeleportLoop)()
        TeleportToTarget()
    else
        ToggleBtn.ImageColor3 = Color3.fromRGB(60, 60, 80)
        ToggleInd.Position = UDim2.new(0, 3, 0.5, -13)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        StatusText.Text = "⏹ OFF"
        StatusText.TextColor3 = Color3.fromRGB(180, 180, 180)
        InfoText.Text = "Click ON để bắt đầu"
        InfoText.TextColor3 = Color3.fromRGB(120, 120, 150)
        ZoneText.TextColor3 = Color3.fromRGB(80, 200, 255)
    end
end

ToggleBtn.MouseButton1Click:Connect(Toggle)

