--[[
    MIU Hub - Island Teleporter V3 (FIXED)
    - Kéo thả UI mượt
    - Thu nhỏ thành ô vuông 50x50
    - Teleport nhanh với CFrame
    - Chống sóng
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- Cấu hình
local Settings = {
    Enabled = false,
    TeleportDelay = 0.3,
    Minimized = false,
    CurrentZone = nil
}

-- Danh sách zones (từ cao xuống thấp)
local ZoneOrder = {
    "Celestial",
    "OG",
    "Hacked",
    "Divine",
    "Secret",
    "Godly",
    "Mythic",
    "Legend",
    "Epic",
    "Rare",
    "Common"
}

-- Toạ độ cố định cho từng zone (dựa trên khoảng cách từ tâm)
-- Các zone nằm trên trục X dương (hướng forward từ plot)
-- Common gần nhất, Celestial xa nhất
local ZonePositions = {
    Common    = Vector3.new(150, 132, -108),
    Rare      = Vector3.new(350, 132, -108),
    Epic      = Vector3.new(550, 132, -108),
    Legend    = Vector3.new(780, 132, -108),
    Mythic    = Vector3.new(1050, 132, -108),
    Godly     = Vector3.new(1350, 132, -108),
    Secret    = Vector3.new(1700, 132, -108),
    Divine    = Vector3.new(2100, 132, -108),
    Hacked    = Vector3.new(2600, 132, -108),
    OG        = Vector3.new(3200, 132, -108),
    Celestial = Vector3.new(4000, 132, -108)
}

-- Fallback: tự tìm zone parts trong workspace
local function FindZonePart(zoneName)
    -- Thử workspace.Areas
    local areas = workspace:FindFirstChild("Areas")
    if areas then
        for _, child in pairs(areas:GetChildren()) do
            local nameUpper = child.Name:upper()
            if nameUpper:find(zoneName:upper()) then
                if child:IsA("BasePart") then return child end
                local pp = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                if pp then return pp end
            end
        end
    end
    
    -- Tìm toàn bộ workspace
    for _, child in pairs(workspace:GetDescendants()) do
        if child:IsA("BasePart") then
            local nameUpper = child.Name:upper()
            if nameUpper:find(zoneName:upper()) or nameUpper:find(zoneName:sub(1, 4):upper()) then
                return child
            end
        end
    end
    
    return nil
end

local function GetZoneCFrame(zoneName)
    -- Ưu tiên tìm part trong game
    local part = FindZonePart(zoneName)
    if part then
        return part.CFrame + Vector3.new(0, part.Size.Y / 2 + 5, 0)
    end
    
    -- Fallback dùng toạ độ cố định
    local pos = ZonePositions[zoneName]
    if pos then
        return CFrame.new(pos)
    end
    
    return nil
end

-- Xác định zone hiện tại dựa trên vị trí nhân vật
local function GetCurrentZone()
    local char = Player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local pos = hrp.Position
    local closestZone = nil
    local closestDist = math.huge
    
    for _, zoneName in ipairs(ZoneOrder) do
        -- Thử part trước
        local part = FindZonePart(zoneName)
        local zonePos
        if part then
            zonePos = part.Position
        else
            zonePos = ZonePositions[zoneName]
        end
        
        if zonePos then
            local dist = (pos - zonePos).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestZone = zoneName
            end
        end
    end
    
    -- Ngưỡng 250 studs để xác định đang ở zone nào
    if closestDist < 300 then
        return closestZone
    end
    
    return nil
end

-- Lấy danh sách zone cần teleport (từ zone hiện tại xuống Common)
local function GetZonesToTeleport()
    local current = GetCurrentZone()
    local startIdx = 1
    
    if current then
        Settings.CurrentZone = current
        for i, name in ipairs(ZoneOrder) do
            if name == current then
                startIdx = i
                break
            end
        end
    end
    
    local result = {}
    for i = startIdx + 1, #ZoneOrder do
        table.insert(result, ZoneOrder[i])
    end
    
    if #result == 0 and current then
        -- Đã ở Common rồi
        return result
    end
    
    return result
end

-- Teleport tới zone
local function TeleportToZone(zoneName)
    local success, result = pcall(function()
        local cf = GetZoneCFrame(zoneName)
        if not cf then return false end
        
        local char = Player.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        -- Teleport tức thời
        hrp.CFrame = cf
        
        -- Reset velocity chống sóng
        hrp.Velocity = Vector3.new(0, -20, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, -20, 0)
        
        -- Xoá BodyVelocity nếu có
        for _, bv in pairs(hrp:GetChildren()) do
            if bv:IsA("BodyVelocity") or bv:IsA("BodyPosition") then
                bv:Destroy()
            end
        end
        
        return true
    end)
    
    return success and result
end

-- Main loop
local function StartTeleport()
    while Settings.Enabled do
        local success, err = pcall(function()
            local zones = GetZonesToTeleport()
            
            if #zones == 0 then
                local cur = GetCurrentZone() or "không xác định"
                print("✅ Đã ở zone thấp nhất: " .. cur)
                Settings.Enabled = false
                UpdateUI()
                return
            end
            
            for _, zoneName in ipairs(zones) do
                if not Settings.Enabled then break end
                
                local ok = TeleportToZone(zoneName)
                if ok then
                    print("➡ Teleport tới: " .. zoneName)
                else
                    print("⚠ Không teleport được: " .. zoneName .. " (dùng toạ độ mặc định)")
                    -- Thử dùng toạ độ cố định
                    local pos = ZonePositions[zoneName]
                    if pos then
                        local char = Player.Character
                        if char then
                            local hrp = char:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                hrp.CFrame = CFrame.new(pos)
                                wait(0.05)
                            end
                        end
                    end
                end
                
                task.wait(Settings.TeleportDelay)
            end
            
            if Settings.Enabled then
                print("✅ Hoàn thành teleport!")
                Settings.Enabled = false
                UpdateUI()
            end
        end)
        
        if not success then
            warn("Lỗi: " .. tostring(err))
            task.wait(1)
        end
    end
end

