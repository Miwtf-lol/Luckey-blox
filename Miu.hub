-- ===== UI FUNCTIONS =====
function UpdateUI()
    if Settings.Minimized then return end
    
    local currentIsland = GetCurrentIsland()
    if currentIsland then
        CurrentPosLabel.Text = "📍 Vị trí: " .. currentIsland
        CurrentPosLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
        
        local islands = GetIslandsToTeleport()
        if #islands > 0 then
            RouteLabel.Text = "Route: " .. table.concat(islands, " → ")
            RouteLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        else
            RouteLabel.Text = "✅ Đã ở đảo thấp nhất!"
            RouteLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    else
        CurrentPosLabel.Text = "📍 Ngoài đảo / Không xác định"
        CurrentPosLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        RouteLabel.Text = "Route: Bắt đầu từ Celestial"
        RouteLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
    end
    
    if Settings.Enabled then
        StatusLabel.Text = "▶ ĐANG TELEPORT..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
        ToggleLabel.Text = "⏹ Dừng"
    else
        StatusLabel.Text = "⏹ Sẵn sàng"
        StatusLabel.TextColor3 = Color3.fromRGB(120, 120, 150)
        ToggleLabel.Text = "▶ Bắt đầu"
    end
end

-- Toggle
local isOn = false
local function ToggleTeleport()
    if Settings.Minimized then return end
    
    isOn = not isOn
    Settings.Enabled = isOn
    
    if isOn then
        ToggleBtn.ImageColor3 = Color3.fromRGB(0, 200, 80)
        ToggleInd.Position = UDim2.new(0, 39, 0.5, -14)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ToggleLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
        StatusLabel.Text = "▶ ĐANG TELEPORT..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
        
        -- Bắt đầu teleport
        coroutine.wrap(IslandTeleportLoop)()
    else
        ToggleBtn.ImageColor3 = Color3.fromRGB(60, 60, 80)
        ToggleInd.Position = UDim2.new(0, 3, 0.5, -14)
        ToggleInd.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        ToggleLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        StatusLabel.Text = "⏹ Đã dừng"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
 end

ToggleBtn.MouseButton1Click:Connect(ToggleTeleport)

-- Cập nhật UI tự động
task.spawn(function()
    while task.wait(1) do
        if not Settings.Enabled and not Settings.Minimized then
            UpdateUI()
        end
    end
end)

-- Cập nhật lần đầu
