--[[
    MIU Hub - Safe Zone Teleporter
    Tự động teleport về SAPE ZONE khi bật ON
]]

local MIU_Teleport = {}
MIU_Teleport.__index = MIU_Teleport

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local Player = Players.LocalPlayer
local Char = Player.Character or Player.CharacterAdded:Wait()

-- Settings
local Settings = {
    Enabled = false,
    TeleportSpeed = 0.5, -- Thời gian delay giữa các lần check (giây)
    SafeZoneName = "SAPE ZONE", -- Tên vùng an toàn
    SafeZoneTag = "SafeZone" -- Tag hoặc tên khác nếu có
}

-- Tìm Safe Zone
local function FindSafeZone()
    -- Cách 1: Tìm theo tên
    local safeZone = workspace:FindFirstChild(Settings.SafeZoneName)
    if safeZone then
        return safeZone
    end
    
    -- Cách 2: Tìm theo tên tương tự
    for _, v in pairs(workspace:GetDescendants()) do
        local name = (v.Name or ""):upper()
        if name:find("SAFE") or name:find("SAPE") or name:find("ZONE") or name:find("SAFEZONE") or name:find("SPAWN") then
            if v:IsA("BasePart") or v:IsA("Model") then
                return v
            end
        end
    end
    
    -- Cách 3: Tìm part có chứa "Safe" trong tên
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name:lower():find("safe") or v.Name:lower():find("zone")) then
            return v
        end
    end
    
    return nil
end

-- Hàm teleport
local function TeleportToSafeZone()
    pcall(function()
        local safeZone = FindSafeZone()
        if not safeZone then return end
        
        local character = Player.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        -- Lấy vị trí đích
        local targetPosition
        
        if safeZone:IsA("BasePart") then
            targetPosition = safeZone.Position + Vector3.new(0, safeZone.Size.Y / 2 + 3, 0)
        elseif safeZone:IsA("Model") then
            local primaryPart = safeZone.PrimaryPart
            if primaryPart then
                targetPosition = primaryPart.Position + Vector3.new(0, primaryPart.Size.Y / 2 + 3, 0)
            else
                -- Lấy part đầu tiên trong model
                local parts = safeZone:GetDescendants()
                for _, part in pairs(parts) do
                    if part:IsA("BasePart") then
                        targetPosition = part.Position + Vector3.new(0, part.Size.Y / 2 + 3, 0)
                        break
                    end
                end
            end
        end
        
        if targetPosition then
            -- Có thể dùng CFrame để teleport
            humanoidRootPart.CFrame = CFrame.new(targetPosition)
            
            -- Hoặc dùng Tween để mượt hơn (tùy chọn)
            -- local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            -- local tween = TweenService:Create(humanoidRootPart, tweenInfo, {CFrame = CFrame.new(targetPosition)})
            -- tween:Play()
        end
    end)
end

-- Kiểm tra và tự động teleport
local function AutoTeleportLoop()
    while Settings.Enabled and task.wait(Settings.TeleportSpeed) do
        pcall(function()
            local character = Player.Character
            if not character then return end
            
            local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
            if not humanoidRootPart then return end
            
            -- Kiểm tra xem đã ở safe zone chưa
            local safeZone = FindSafeZone()
            if not safeZone then return end
            
            -- Tính khoảng cách đến safe zone
            local dist = 999999
            if safeZone:IsA("BasePart") then
                dist = (humanoidRootPart.Position - safeZone.Position).Magnitude
            elseif safeZone:IsA("Model") and safeZone.PrimaryPart then
                dist = (humanoidRootPart.Position - safeZone.PrimaryPart.Position).Magnitude
            end
            
            -- Nếu khoảng cách > 50, teleport về safe zone
            if dist > 50 then
                TeleportToSafeZone()
            end
        end)
    end
end

-- Khi nhân vật mới xuất hiện
Player.CharacterAdded:Connect(function(newChar)
    Char = newChar
    -- Nếu đang bật, tiếp tục loop
    if Settings.Enabled then
        coroutine.wrap(AutoTeleportLoop)()
    end
end)

