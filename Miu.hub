--[[
    MIU Hub - Teleport to COMMON (Full Drag UI)
    Có thể kéo toàn bộ UI, không chỉ thanh tiêu đề
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local Player = Players.LocalPlayer
local Char = Player.Character or Player.CharacterAdded:Wait()

-- Settings
local Settings = {
    Enabled = false,
    TeleportSpeed = 0.5,
    TargetName = "COMMON"
}

-- =====================
-- TELEPORT LOGIC
-- =====================

local function FindTarget()
    -- Tìm theo tên chính xác trước
    local obj = workspace:FindFirstChild(Settings.TargetName)
    if obj then return obj end
    
    -- Tìm mở rộng
    for _, v in pairs(workspace:GetDescendants()) do
        local name = (v.Name or ""):upper()
        if name:find("COMMON") or name:find("SAFE") or name:find("SPAWN") or name:find("LOBBY") then
            if v:IsA("BasePart") or v:IsA("Model") then
                return v
            end
        end
    end
    
    -- Tìm platform lớn
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Size.X > 15 and v.Size.Z > 15 then
            return v
        end
    end
    
    return nil
end

local function TeleportToTarget()
    pcall(function()
        local target = FindTarget()
        if not target then return end
        
        local char = Player.Character
        if not char then return end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local pos
        if target:IsA("BasePart") then
            pos = target.Position + Vector3.new(0, target.Size.Y/2 + 3, 0)
        elseif target:IsA("Model") then
            local pp = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
            if pp then
                pos = pp.Position + Vector3.new(0, pp.Size.Y/2 + 3, 0)
            end
        end
        
        if pos then
            hrp.CFrame = CFrame.new(pos)
        end
    end)
end

local function AutoTeleportLoop()
    while Settings.Enabled and task.wait(Settings.TeleportSpeed) do
        pcall(function()
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local target = FindTarget()
            if not target then return end
            
            local dist = 999
            if target:IsA("BasePart") then
                dist = (hrp.Position - target.Position).Magnitude
            elseif target:IsA("Model") then
                local pp = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
                if pp then dist = (hrp.Position - pp.Position).Magnitude end
            end
            
            if dist > 30 then
                TeleportToTarget()
            end
        end)
    end
end

Player.CharacterAdded:Connect(function(newChar)
    Char = newChar
    if Settings.Enabled then
        coroutine.wrap(AutoTeleportLoop)()
    end
end)

