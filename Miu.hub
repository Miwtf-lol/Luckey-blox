    if Settings.Minimized then
        -- Chỉ mở lại nếu click không phải để kéo
        if not dragging then
            ToggleMinimize()
        end
    end
end)

-- Auto update UI
task.spawn(function()
    while task.wait(1.5) do
        if not Settings.Enabled and not Settings.Minimized then
            UpdateUI()
        end
    end
end)

