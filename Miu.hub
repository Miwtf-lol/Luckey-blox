--[[ 
    MIU Hub - Island Teleporter (FULL FIXED + UI IMPROVED)
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local Player = Players.LocalPlayer

-- Settings
local Settings = {
    Enabled = false,
    TeleportDelay = 0.2, -- ⚡ nhanh hơn
    CurrentIsland = nil,
}

-- Island list
local IslandOrder = {
    "Celestial","OG","Hacked","Divine","Secret",
    "Godly","Mythic","Legend","Epic","Rare","Common"
}

local IslandKeywords = {
    Celestial = {"CELESTIAL","CELEST"},
    OG = {"OG","ORIGINAL"},
    Hacked = {"HACKED","HACK"},
    Divine = {"DIVINE"},
    Secret = {"SECRET"},
    Godly = {"GODLY","GOD"},
    Mythic = {"MYTHIC"},
    Legend = {"LEGEND"},
    Epic = {"EPIC"},
    Rare = {"RARE"},
    Common = {"COMMON","SPAWN","LOBBY"}
}

-- Find island
local function FindIsland(name)
    local keys = IslandKeywords[name] or {name:upper()}
    for _, v in pairs(workspace:GetDescendants()) do
        local n = v.Name:upper()
        for _, k in pairs(keys) do
            if n:find(k) then
                if v:IsA("BasePart") then return v end
                if v:IsA("Model") then
                    return v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                end
            end
        end
    end
end

-- Teleport (FAST)
local function Teleport(island)
    local part = FindIsland(island)
    if not part then return false end

    local char = Player.Character
    if not char then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local pos = part.Position + Vector3.new(0, 8, 0)

    -- ⚡ anti loading + fast TP
    pcall(function()
        game:GetService("Players").LocalPlayer:RequestStreamAroundAsync(pos)
    end)

    for i = 1, 2 do
        hrp:PivotTo(CFrame.new(pos))
        task.wait()
    end

    return true
end

-- Loop
local function Loop()
    while Settings.Enabled do
        task.wait(Settings.TeleportDelay)

        for _, island in ipairs(IslandOrder) do
            if not Settings.Enabled then break end
            Teleport(island)
            task.wait(Settings.TeleportDelay)
        end

        Settings.Enabled = false
    end
end

-- ================= UI =================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = CoreGui
ScreenGui.Name = "MIU_HUB"

local Main = Instance.new("Frame")
Main.Size = UDim2.new(0, 300, 0, 220)
Main.Position = UDim2.new(0.5, -150, 0.5, -110)
Main.BackgroundColor3 = Color3.fromRGB(20,20,30)
Main.Parent = ScreenGui
Instance.new("UICorner", Main)

local Content = Instance.new("Frame")
Content.Size = UDim2.new(1,0,1,0)
Content.BackgroundTransparency = 1
Content.Parent = Main

-- HEADER
local Header = Instance.new("Frame")
Header.Size = UDim2.new(1,0,0,40)
Header.BackgroundColor3 = Color3.fromRGB(35,35,55)
Header.Parent = Main
Instance.new("UICorner", Header)

local Title = Instance.new("TextLabel")
Title.Text = "MIU ISLAND HUB"
Title.Size = UDim2.new(1,0,1,0)
Title.BackgroundTransparency = 1
Title.TextColor3 = Color3.new(1,1,1)
Title.Font = Enum.Font.GothamBold
Title.Parent = Header

-- CLOSE
local Close = Instance.new("TextButton")
Close.Text = "X"
Close.Size = UDim2.new(0,22,0,22)
Close.Position = UDim2.new(1,-25,0.5,-11)
Close.BackgroundColor3 = Color3.fromRGB(255,80,80)
Close.Parent = Header
Instance.new("UICorner", Close)

Close.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- MINIMIZE
local Min = Instance.new("TextButton")
Min.Text = "-"
Min.Size = UDim2.new(0,22,0,22)
Min.Position = UDim2.new(1,-55,0.5,-11)
Min.BackgroundColor3 = Color3.fromRGB(255,170,0)
Min.Parent = Header
Instance.new("UICorner", Min)

local minimized = false
local originalSize = Main.Size

Min.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        TweenService:Create(Main,TweenInfo.new(0.2),{
            Size = UDim2.new(0,300,0,40)
        }):Play()
        Content.Visible = false
    else
        TweenService:Create(Main,TweenInfo.new(0.2),{
            Size = originalSize
        }):Play()
        Content.Visible = true
    end
end)

-- DRAG (SMOOTH)
local dragging, dragStart, startPos

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- BUTTON
local Btn = Instance.new("TextButton")
Btn.Size = UDim2.new(0,200,0,40)
Btn.Position = UDim2.new(0.5,-100,0.5,-20)
Btn.Text = "START TELEPORT"
Btn.Parent = Content

Btn.MouseButton1Click:Connect(function()
    Settings.Enabled = not Settings.Enabled

    if Settings.Enabled then
        Btn.Text = "RUNNING..."
        coroutine.wrap(Loop)()
    else
        Btn.Text = "START TELEPORT"
    end
end)

print("MIU HUB LOADED ✔")
