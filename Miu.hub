-- ===== MINIMIZE / MAXIMIZE =====
local function ToggleMinimize()
    Settings.Minimized = not Settings.Minimized
    
    if Settings.Minimized then
        -- Thu nhỏ thành ô vuông nhỏ
        Main:TweenSize(UDim2.new(0, 50, 0, 50), "Out", "Quad", 0.3, true)
        Main:TweenPosition(UDim2.new(0, Main.AbsolutePosition.X + 135, 0, Main.AbsolutePosition.Y + 95), "Out", "Quad", 0.3, true)
        wait(0.15)
        Content.Visible = false
        Header.Visible = false
        
        -- Tạo icon thu nhỏ
        MinIcon.Visible = true
    else
        -- Mở rộng lại
        Content.Visible = true
        Header.Visible = true
        MinIcon.Visible = false
        Main:TweenSize(UDim2.new(0, 320, 0, 240), "Out", "Quad", 0.3, true)
    end
end

MinBtn.MouseButton1Click:Connect(ToggleMinimize)

