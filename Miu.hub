--[[
    MIU Hub - Island Teleporter
    Tự động teleport lần lượt qua các đảo từ vị trí hiện tại đến Common
    Thứ tự: Celestial → OG → Hacked → Divine → Secret → Godly → Mythic → Legend → Epic → Rare → Common
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local Player = Players.LocalPlayer

-- Settings
local Settings = {
    Enabled = false,
    TeleportDelay = 1.5, -- Delay giữa các lần tele (giây)
    CurrentIsland = nil,
    AutoFindIsland = true
}

-- Danh sách đảo theo thứ tự từ cao đến thấp
local IslandOrder = {
    "Celestial",
    "OG",
    "Hacked",
    "Divine",
    "Secret",
    "Godly",
    "Mythic",
    "Legend",
    "Epic",
    "Rare",
    "Common"
}

-- Từ khóa mở rộng cho mỗi đảo
local IslandKeywords = {
    Celestial = {"CELESTIAL", "CELEST", "CLELESTIAL"},
    OG = {"OG", "ORIGINAL", "OG ISLAND"},
    Hacked = {"HACKED", "HACK", "HACKED ISLAND"},
    Divine = {"DIVINE", "DIVIN", "DIVINE ISLAND"},
    Secret = {"SECRET", "SECRET ISLAND"},
    Godly = {"GODLY", "GOD", "GODLY ISLAND"},
    Mythic = {"MYTHIC", "MYTH", "MYTHIC ISLAND"},
    Legend = {"LEGEND", "LEGENDARY", "LEGEND ISLAND"},
    Epic = {"EPIC", "EPIC ISLAND"},
    Rare = {"RARE", "RARE ISLAND"},
    Common = {"COMMON", "COMMOM", "SAFE", "SPAWN", "LOBBY"}
}

-- Hàm tìm đảo theo tên
local function FindIsland(islandName)
    local keywords = IslandKeywords[islandName] or {islandName:upper()}
    
    for _, v in pairs(workspace:GetDescendants()) do
        local name = (v.Name or ""):upper()
        for _, kw in pairs(keywords) do
            if name:find(kw) then
                if v:IsA("BasePart") then
                    return v
                elseif v:IsA("Model") then
                    local pp = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                    if pp then return pp end
                    -- Nếu không có primary part, tìm part lớn nhất
                    local biggestPart = nil
                    local biggestSize = 0
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") and (part.Size.X * part.Size.Y * part.Size.Z) > biggestSize then
                            biggestSize = part.Size.X * part.Size.Y * part.Size.Z
                            biggestPart = part
                        end
                    end
                    if biggestPart then return biggestPart end
                end
            end
        end
    end
    return nil
end

-- Hàm xác định vị trí hiện tại đang ở đảo nào
local function GetCurrentIsland()
    local char = Player.Character
    if not char then return nil end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local pos = hrp.Position
    
    -- Kiểm tra từng đảo và tính khoảng cách
    local closestIsland = nil
    local closestDist = math.huge
    
    for _, islandName in ipairs(IslandOrder) do
        local islandPart = FindIsland(islandName)
        if islandPart then
            local dist = (pos - islandPart.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestIsland = islandName
            end
        end
    end
    
    -- Chỉ xác định là đang ở đảo nếu khoảng cách < 100 studs
    if closestDist < 100 then
        return closestIsland
    end
    
    return nil
end

-- Hàm teleport đến một đảo cụ thể
local function TeleportToIsland(islandName)
    pcall(function()
        local islandPart = FindIsland(islandName)
        if not islandPart then 
            print("⚠️ Không tìm thấy đảo: " .. islandName)
            return false 
        end
        
        local char = Player.Character
        if not char then return false end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        -- Tính vị trí đứng trên đảo
        local targetPos = islandPart.Position + Vector3.new(0, islandPart.Size.Y / 2 + 5, 0)
        
        -- Teleport
        hrp.CFrame = CFrame.new(targetPos)
        
        print("✅ Teleported to: " .. islandName)
        return true
    end)
    return false
end

-- Hàm lấy danh sách đảo cần tele từ vị trí hiện tại
local function GetIslandsToTeleport()
    local currentIsland = GetCurrentIsland()
    if not currentIsland then
        -- Nếu không xác định được, tele từ đầu
        print("⚠️ Không xác định được vị trí, bắt đầu từ đầu")
        return IslandOrder
    end
    
    Settings.CurrentIsland = currentIsland
    print("📍 Vị trí hiện tại: " .. currentIsland)
    
    -- Tìm index của đảo hiện tại
    local currentIndex = nil
    for i, name in ipairs(IslandOrder) do
        if name == currentIsland then
            currentIndex = i
            break
        end
    end
    
    if not currentIndex then
        return IslandOrder
    end
    
    -- Lấy danh sách đảo từ vị trí hiện tại đến Common
    local islandsToTeleport = {}
    for i = currentIndex, #IslandOrder do
        table.insert(islandsToTeleport, IslandOrder[i])
    end
    
    -- Bỏ qua đảo hiện tại (đang đứng)
    if #islandsToTeleport > 1 then
        table.remove(islandsToTeleport, 1)
    end
    
    return islandsToTeleport
end

-- Main loop
local function IslandTeleportLoop()
    while Settings.Enabled and task.wait(Settings.TeleportDelay) do
        pcall(function()
            local islands = GetIslandsToTeleport()
            
            if #islands == 0 then
                print("✅ Đã ở đảo thấp nhất! (Common)")
                Settings.Enabled = false
                return
            end
            
            print("🔄 Đang tele: " .. table.concat(islands, " → "))
            
            for _, islandName in ipairs(islands) do
                if not Settings.Enabled then break end
                
                local success = TeleportToIsland(islandName)
                if success then
                    task.wait(Settings.TeleportDelay)
                else
                    -- Thử tìm lại với từ khóa khác
                    local found = false
                    for _, kw in pairs(IslandKeywords[islandName] or {}) do
                        for _, v in pairs(workspace:GetDescendants()) do
                            if v:IsA("BasePart") and (v.Name:upper():find(kw) or (v.Parent and v.Parent.Name:upper():find(kw))) then
                                local targetPos = v.Position + Vector3.new(0, v.Size.Y / 2 + 5, 0)
                                local char = Player.Character
                                if char and char:FindFirstChild("HumanoidRootPart") then
                                    char.HumanoidRootPart.CFrame = CFrame.new(targetPos)
                                    print("✅ Teleported to: " .. islandName .. " (alternative)")
                                    found = true
                                end
                                break
                            end
                        end
                        if found then break end
                    end
                    task.wait(Settings.TeleportDelay)
                end
            end
            
            -- Sau khi tele xong, dừng lại
            if Settings.Enabled then
                print("✅ Hoàn thành! Đã tele đến Common")
                Settings.Enabled = false
                -- Cập nhật UI
                if UpdateUI then UpdateUI() end
            end
        end)
    end
end

