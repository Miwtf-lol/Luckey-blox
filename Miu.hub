-- Expose global API
_G.MIU_TP = {
    Start = function()
        if not Settings.Enabled then ToggleTeleport() end
    end,
    Stop = function()
        if Settings.Enabled then ToggleTeleport() end
    end,
    Minimize = ToggleMinimize,
    Status = function() return Settings.Enabled end,
    CurrentZone = function() return GetCurrentZone() end
}
