-- Toggle function
local isOn = false
local function UpdateToggle()
    isOn = not isOn
    Settings.Enabled = isOn
    
    if isOn then
        ToggleButton.ImageColor3 = Color3.fromRGB(0, 200, 80)
        ToggleIndicator.Position = UDim2.new(0, 37, 0.5, -12)
        ToggleIndicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        StatusLabel.Text = "Status: ON"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
        InfoLabel.Text = "✓ Auto teleport enabled"
        InfoLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
        
        -- Start loop
        coroutine.wrap(AutoTeleportLoop)()
        
        -- Teleport ngay lập tức
        TeleportToSafeZone()
    else
        ToggleButton.ImageColor3 = Color3.fromRGB(60, 60, 80)
        ToggleIndicator.Position = UDim2.new(0, 3, 0.5, -12)
        ToggleIndicator.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        StatusLabel.Text = "Status: OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        InfoLabel.Text = "✕ Auto TP disabled"
        InfoLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end

ToggleButton.MouseButton1Click:Connect(UpdateToggle)

-- Drag functionality
local dragging = false
local dragStart = Vector2.new()
local startPos = Vector2.new()

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        local absPos = MainFrame.AbsolutePosition
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        startPos = Vector2.new(absPos.X, absPos.Y)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(0, startPos.X + delta.X, 0, startPos.Y + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

