--[[
    MIU Hub - Island Teleporter PRO
    - Auto tele khi biến thành entity ở các đảo
    - Phát hiện tên trên đầu để xác định đảo
    - Thứ tự: Common → Rare → Epic → Legend → Mythic → Godly → Secret → Hacked → OG → Celestial
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local plr = Players.LocalPlayer

-- Settings
local Settings = {
    Enabled = false,
    CheckInterval = 0.3,
    TeleportDelay = 0.2,
    CurrentIsland = nil,
    
    -- Auto TP khi biến hình
    AutoTPOnTransform = true,
    
    -- Danh sách các đảo theo cấp (từ thấp đến cao)
    IslandTiers = {
        ["Common"] = 1,
        ["Rare"] = 2,
        ["Epic"] = 3,
        ["Legend"] = 4,
        ["Mythic"] = 5,
        ["Godly"] = 6,
        ["Secret"] = 7,
        ["Hacked"] = 8,
        ["OG"] = 9,
        ["Celestial"] = 10
    },
    
    -- Danh sách tên đảo từ thấp đến cao
    IslandNames = {"Common", "Rare", "Epic", "Legend", "Mythic", "Godly", "Secret", "Hacked", "OG", "Celestial"},
    
    -- Entity keywords cho mỗi đảo (các con vật/entity xuất hiện trên đảo đó)
    IslandEntities = {
        Common = {"COMMON", "SLIME", "BUNNY", "CHICKEN", "PIG", "COW", "SHEEP", "BEGGINER", "NOOB", "BABY"},
        Rare = {"RARE", "WOLF", "FOX", "DEER", "PANDA", "BIRD", "EAGLE"},
        Epic = {"EPIC", "TIGER", "LION", "BEAR", "GORILLA", "ELEPHANT", "RHINO"},
        Legend = {"LEGEND", "DRAGON", "PHOENIX", "UNICORN", "GRYPHON", "PEGASUS", "KRAKEN"},
        Mythic = {"MYTHIC", "DEMON", "ANGEL", "REAPER", "NECROMANCER", "DARK_KNIGHT", "WRAITH"},
        Godly = {"GODLY", "GOD", "ZEUS", "THOR", "ODIN", "APOLLO", "HERA", "TITAN"},
        Secret = {"SECRET", "SHADOW", "VOID", "COSMIC", "GALAXY", "NEBULA", "MYSTERY", "HIDDEN"},
        Hacked = {"HACKED", "HACKER", "GLITCH", "CYBER", "VIRUS", "CORRUPT", "ERROR", "CODE"},
        OG = {"OG", "ORIGINAL", "VETERAN", "ALPHA", "BETA", "LEGACY", "CLASSIC", "ANCIENT"},
        Celestial = {"CELESTIAL", "CELEST", "STAR", "MOON", "SUN", "COMET", "ASTRAL", "GALACTIC", "UNIVERSE"}
    }
}

-- =====================
-- DETECTION ENGINE
-- =====================

-- Phát hiện tất cả các entity/con vật trên đầu có tên tương ứng với đảo
local function DetectHeadName()
    local char = plr.Character
    if not char then return nil end
    
    -- Kiểm tra HumanoidRootPart hoặc Head
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not head then return nil end
    
    -- Kiểm tra BillboardGui trên đầu (tên hiển thị trên đầu entity)
    local billboards = {}
    for _, child in pairs(head:GetChildren()) do
        if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
            table.insert(billboards, child)
        end
    end
    
    -- Kiểm tra tất cả descendants
    for _, desc in pairs(head:GetDescendants()) do
        if desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
            table.insert(billboards, desc)
        end
    end
    
    -- Kiểm tra PlayerGui
    local playerGui = plr:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in pairs(playerGui:GetDescendants()) do
            if gui:IsA("BillboardGui") and gui.Adornee == head then
                table.insert(billboards, gui)
            end
        end
    end
    
    -- Đọc tên từ các BillboardGui
    for _, billboard in pairs(billboards) do
        for _, child in pairs(billboard:GetChildren()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                local text = child.Text or ""
                local upperText = text:upper():gsub("%s+", "")
                
                -- Kiểm tra xem text có chứa tên đảo không
                for islandName, _ in pairs(Settings.IslandTiers) do
                    local upperIsland = islandName:upper()
                    if upperText:find(upperIsland) then
                        return islandName, text
                    end
                end
                
                -- Kiểm tra từ khóa mở rộng
                for islandName, keywords in pairs(Settings.IslandEntities) do
                    for _, kw in ipairs(keywords) do
                        if upperText:find(kw) then
                            return islandName, text
                        end
                    end
                end
            end
        end
    end
    
    return nil
end

-- Kiểm tra toàn bộ cơ thể để phát hiện biến hình
local function DetectTransformation()
    local char = plr.Character
    if not char then return nil end
    
    local humanoid = char:FindFirstChildWhichIsA("Humanoid")
    if not humanoid then return nil end
    
    -- 1. Kiểm tra BillboardGui trên đầu (ưu tiên cao nhất)
    local islandName, displayText = DetectHeadName()
    if islandName then
        return islandName, displayText
    end
    
    -- 2. Kiểm tra tên model nhân vật
    local charName = char.Name:upper()
    for islandName, keywords in pairs(Settings.IslandEntities) do
        for _, kw in ipairs(keywords) do
            if charName:find(kw) then
                return islandName, char.Name
            end
        end
    end
    
    -- 3. Kiểm tra Humanoid.DisplayName
    local displayName = humanoid.DisplayName or ""
    local upperDisplay = displayName:upper()
    for islandName, keywords in pairs(Settings.IslandEntities) do
        for _, kw in ipairs(keywords) do
            if upperDisplay:find(kw) then
                return islandName, displayName
            end
        end
    end
    
    -- 4. Kiểm tra Attributes
    local attrs = char:GetAttributes()
    for key, val in pairs(attrs) do
        local keyStr = tostring(key):upper()
        local valStr = tostring(val):upper()
        for islandName, keywords in pairs(Settings.IslandEntities) do
            for _, kw in ipairs(keywords) do
                if keyStr:find(kw) or valStr:find(kw) then
                    return islandName, valStr
                end
            end
        end
    end
    
    -- 5. Kiểm tra Accessories (mũ, vật phẩm trang bị) 
    for _, child in pairs(char:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Hat") or child:IsA("Tool") then
            local childName = child.Name:upper()
            local handle = child:FindFirstChild("Handle")
            local handleName = handle and handle.Name:upper() or ""
            
            for islandName, keywords in pairs(Settings.IslandEntities) do
                for _, kw in ipairs(keywords) do
                    if childName:find(kw) or handleName:find(kw) then
                        return islandName, child.Name
                    end
                end
            end
        end
    end
    
    -- 6. Kiểm tra MeshParts và SpecialMesh
    for _, desc in pairs(char:GetDescendants()) do
        if desc:IsA("MeshPart") or desc:IsA("SpecialMesh") then
            local meshName = (desc.Name .. " " .. (desc.MeshId or "")):upper()
            for islandName, keywords in pairs(Settings.IslandEntities) do
                for _, kw in ipairs(keywords) do
                    if meshName:find(kw) then
                        return islandName, desc.Name
                    end
                end
            end
        end
    end
    
    -- 7. Kiểm tra Animation đang chơi
    local animator = humanoid:FindFirstChildWhichIsA("Animator")
    if animator then
        for _, track in pairs(animator:GetPlayingAnimationTracks()) do
            local animName = (track.Animation and track.Animation.Name or ""):upper()
            local animId = (track.Animation and track.Animation.AnimationId or ""):upper()
            for islandName, keywords in pairs(Settings.IslandEntities) do
                for _, kw in ipairs(keywords) do
                    if animName:find(kw) or animId:find(kw) then
                        return islandName, track.Animation.Name
                    end
                end
            end
        end
    end
    
    -- 8. Kiểm tra BodyEffects/Effects
    local effects = char:FindFirstChild("BodyEffects") or char:FindFirstChild("Effects") or char:FindFirstChild("BodysEffects")
    if effects then
        for _, child in pairs(effects:GetChildren()) do
            local n = child.Name:upper()
            for islandName, keywords in pairs(Settings.IslandEntities) do
                for _, kw in ipairs(keywords) do
                    if n:find(kw) then return islandName, child.Name end
                end
            end
        end
    end
    
    -- 9. Kiểm tra qua RemoteEvent (game-specific)
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
            local rName = remote.Name:upper()
            for islandName, keywords in pairs(Settings.IslandEntities) do
                for _, kw in ipairs(keywords) do
                    if rName:find(kw) then
                        -- Game có event cho entity này, khả năng cao đã biến hình
                        return islandName, remote.Name
                    end
                end
            end
        end
    end
    
    return nil
end

-- =====================
-- ISLAND FINDER
-- =====================

local function FindIslandPart(islandName)
    local keywords = Settings.IslandEntities[islandName] or {islandName:upper()}
    
    -- Tìm model/part của đảo
    for _, v in pairs(workspace:GetDescendants()) do
        local name = (v.Name or ""):upper()
        local parentName = (v.Parent and v.Parent.Name or ""):upper()
        
        for _, kw in ipairs(keywords) do
            if name:find(kw) or parentName:find(kw) then
                if v:IsA("BasePart") then
                    return v
                elseif v:IsA("Model") then
                    local pp = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                    if pp then return pp end
                    
                    local biggestPart = nil
                    local biggestSize = 0
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") and (part.Size.X * part.Size.Y * part.Size.Z) > biggestSize then
                            biggestSize = part.Size.X * part.Size.Y * part.Size.Z
                            biggestPart = part
                        end
                    end
                    if biggestPart then return biggestPart end
                end
            end
        end
    end
    
    -- Fallback: tìm theo tên chính xác
    for _, v in pairs(workspace:GetDescendants()) do
        local name = (v.Name or ""):upper()
        if name:find(islandName:upper()) then
            if v:IsA("BasePart") then
                return v
            elseif v:IsA("Model") then
                local pp = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                if pp then return pp end
            end
        end
    end
    
    return nil
end

-- =====================
-- TELEPORT FUNCTIONS
-- =====================

local function TeleportToIsland(islandName)
    local success = pcall(function()
        local islandPart = FindIslandPart(islandName)
        if not islandPart then 
            print("⚠️ Không tìm thấy đảo: " .. islandName)
            return false 
        end
        
        local char = plr.Character
        if not char then return false end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        local targetPos = islandPart.Position + Vector3.new(0, islandPart.Size.Y / 2 + 8, 0)
        hrp.CFrame = CFrame.new(targetPos)
        
        print("✅ Teleported to: " .. islandName)
        return true
    end)
    return success
end

-- =====================
-- MAIN DETECTION LOOP
-- =====================

local lastTransformState = nil

local function TransformDetectionLoop()
    while task.wait(Settings.CheckInterval) do
        pcall(function()
            if not Settings.Enabled then return end
            if not Settings.AutoTPOnTransform then return end
            
            local currentIsland, displayText = DetectTransformation()
            
            -- Nếu phát hiện biến hình và khác với trạng thái trước đó
            if currentIsland and currentIsland ~= lastTransformState then
                print("🔍 Phát hiện biến hình: " .. (displayText or "Unknown") .. " → Đảo: " .. currentIsland)
                
                -- Teleport đến đảo tương ứng
                local success = TeleportToIsland(currentIsland)
                if success then
                    print("✅ Đã tele đến " .. currentIsland .. " do biến hình thành " .. (displayText or "entity"))
                end
                
                lastTransformState = currentIsland
                
            elseif not currentIsland then
                -- Reset trạng thái nếu không còn biến hình
                if lastTransformState ~= nil then
                    lastTransformState = nil
                end
            end
        end)
    end
end

-- =====================
-- MANUAL TELEPORT LOOP
-- =====================

local function GetAllIslandsFromCurrent()
    -- Tìm đảo gần nhất hiện tại
    local char = plr.Character
    if not char then return Settings.IslandNames end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return Settings.IslandNames end
    
    local pos = hrp.Position
    local closestIsland = nil
    local closestDist = math.huge
    
    for _, islandName in ipairs(Settings.IslandNames) do
        local part = FindIslandPart(islandName)
        if part then
            local dist = (pos - part.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestIsland = islandName
            end
        end
    end
    
    if not closestIsland then return Settings.IslandNames end
    
    -- Lấy danh sách từ đảo hiện tại đến cao nhất
    local result = {}
    local found = false
    for _, islandName in ipairs(Settings.IslandNames) do
        if islandName == closestIsland then
            found = true
        end
        if found then
            table.insert(result, islandName)
        end
    end
    
    -- Nếu chỉ có 1 đảo (đang ở cao nhất), trả về tất cả từ đầu
    if #result <= 1 then
        return Settings.IslandNames
    end
    
    return result
end

local function ManualTeleportLoop()
    while Settings.Enabled and task.wait(Settings.TeleportDelay) do
        pcall(function()
            local islands = GetAllIslandsFromCurrent()
            
            for _, islandName in ipairs(islands) do
                if not Settings.Enabled then break end
                
                -- Kiểm tra xem có đang biến hình không (ưu tiên)
                local transformIsland = DetectTransformation()
                if transformIsland then
                    print("⏸ Phát hiện biến hình trong khi đang tele, chuyển đến " .. transformIsland)
                    TeleportToIsland(transformIsland)
                    break
                end
                
                local success = TeleportToIsland(islandName)
                if success then
                    task.wait(Settings.TeleportDelay)
                end
            end
            
            if Settings.Enabled then
                task.wait(0.5)
            end
        end)
    end
end

