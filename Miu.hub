-- ===== DRAG CẢI TIẾN =====
local dragging = false
local dragStart = Vector2.new()
local startPos = Vector2.new()

-- Dùng UserInputService cho drag mượt hơn
local function onDragStart(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Vector2.new(Main.AbsolutePosition.X, Main.AbsolutePosition.Y)
    end
end

local function onDragMove(input)
    if dragging then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(0, startPos.X + delta.X, 0, startPos.Y + delta.Y)
    end
end

local function onDragEnd(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end

-- Cho phép kéo trên toàn bộ Main Frame
Main.InputBegan:Connect(onDragStart)
UserInputService.InputChanged:Connect(onDragMove)
UserInputService.InputEnded:Connect(onDragEnd)

