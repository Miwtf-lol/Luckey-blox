--// MIU HUB - AUTO KICK + AUTO TELE
--// Mobile + PC

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- REMOTES
local KickEvent = ReplicatedStorage.Shared.Packages.Network.rev_KickEvent
local TransformRemote = ReplicatedStorage.Shared.Packages.Network.rev_Transformed
local CollectRemote = ReplicatedStorage.Shared.Packages.Network.rev_KickCollect

-- SETTINGS
local AutoKick = false

-- TELE POSITION (đổi nếu cần)
local KickPos = Vector3.new(0, 15, 0)

-- GUI
local ScreenGui = Instance.new("ScreenGui")
local Main = Instance.new("Frame")
local Toggle = Instance.new("TextButton")

ScreenGui.Parent = game.CoreGui

Main.Parent = ScreenGui
Main.Size = UDim2.new(0,170,0,70)
Main.Position = UDim2.new(0.5,-85,0.5,-35)
Main.BackgroundColor3 = Color3.fromRGB(255,105,180)
Main.Active = true
Main.Draggable = true

Instance.new("UICorner", Main)

Toggle.Parent = Main
Toggle.Size = UDim2.new(1,-10,1,-10)
Toggle.Position = UDim2.new(0,5,0,5)
Toggle.Text = "AUTO KICK : OFF"
Toggle.TextScaled = true
Toggle.TextColor3 = Color3.new(1,1,1)
Toggle.BackgroundColor3 = Color3.fromRGB(255,20,147)

Instance.new("UICorner", Toggle)

Toggle.MouseButton1Click:Connect(function()
	AutoKick = not AutoKick
	
	if AutoKick then
		Toggle.Text = "AUTO KICK : ON"
	else
		Toggle.Text = "AUTO KICK : OFF"
	end
end)

-- AUTO
task.spawn(function()
	while true do
		if AutoKick then
			pcall(function()

				-- TELE TỚI CHỖ KICK
				HumanoidRootPart.CFrame = CFrame.new(KickPos)

				task.wait(1)

				-- KICK
				KickEvent:FireServer()

				task.wait(1)

				-- BAY VỀ
				TransformRemote:FireServer()

				task.wait(1)

				-- VỀ COLLECT ZONE
				CollectRemote:FireServer()

			end)
		end

		task.wait(5)
	end
end)
