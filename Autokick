-- ===== ANTI-KICK MẠNH MẼ =====
local __namecall
local oldNamecall
local hookConnection = nil

-- Hook metatable để chặn kick
local success, result = pcall(function()
    local mt = getrawmetatable(game)
    if mt then
        __namecall = mt.__namecall
        setreadonly(mt, false)
        
        oldNamecall = __namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            -- Chặn mọi FireServer có chứa "Kick" trong tên
            if method == "FireServer" then
                local selfStr = tostring(self)
                if selfStr:find("Kick") or selfStr:find("kick") then
                    -- Chặn fire server có tên Kick - trả về nil để block
                    return nil
                end
            end
            
            -- Chặn Kick local player
            if method == "Kick" then
                return nil
            end
            
            return oldNamecall(self, ...)
        end)
        
        setreadonly(mt, true)
    end
end)

if not success then
    warn("[ANTI-KICK] Hook metatable failed, using fallback method")
end

