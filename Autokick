--[[
Lucky Blox Auto Farm Script
Tự động bay đến COLLECT ZONE, kick, và quay về
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Anti-Kick Protection
local mt = getrawmetatable(game)
local old_namecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    -- Block kick events
    if method == "FireServer" and tostring(self):find("KickEvent") then
        return -- Block the kick
    end
    
    -- Block RemoteEvents/RemoteFunctions that kick
    if method == "FireServer" and tostring(self):find("rev_Kick") then
        return -- Block kick remotes
    end
    
    return old_namecall(self, ...)
end)

setreadonly(mt, true)

-- Auto Farm Variables
local isFarming = false
local farmConnection = nil

-- Functions
function getCollectZone()
    -- Tìm COLLECT ZONE - điều chỉnh theo map
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name:lower():find("collect") or v.Name:lower():find("zone") then
            return v
        end
    end
    return nil
end

function flyTo(position)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local hrp = character.HumanoidRootPart
    hrp.CFrame = CFrame.new(position)
    
    -- Gửi sự kiện biến đổi/bay
    pcall(function()
        ReplicatedStorage.Shared.Packages.Network.rev_Transformed:FireServer()
    end)
    
    return true
end

function collectZone()
    local zone = getCollectZone()
    if zone then
        flyTo(zone.Position + Vector3.new(0, 5, 0))
        
        -- Fire collect event
        pcall(function()
            ReplicatedStorage.Shared.Packages.Network.rev_KickCollect:FireServer()
        end)
        
        return true
    end
    return false
end

function autoKick()
    -- Auto kick và chọn cái cao nhất
    local args = {
        [1] = "Highest Value",  -- Hoặc giá trị tương ứng
        -- Thêm các args cần thiết khác
    }
    
    pcall(function()
        ReplicatedStorage.Shared.Packages.Network.rev_KickEvent:FireServer(unpack(args))
    end)
    
    -- Delay ngắn trước khi bay về
    task.wait(0.5)
    
    -- Bay về COLLECT ZONE
    collectZone()
end

-- Main Loop
function startFarming()
    isFarming = true
    
    -- Bay đến COLLECT ZONE
    collectZone()
    
    -- Tạo loop auto kick
    farmConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not isFarming then
            farmConnection:Disconnect()
            return
        end
        
        -- Auto kick
        autoKick()
        
        -- Delay giữa các lần kick
        task.wait(2)
    end)
end

function stopFarming()
    isFarming = false
    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
    end
end

-- UI Toggle
local GUI = Instance.new("ScreenGui")
local Button = Instance.new("TextButton")

GUI.Parent = LocalPlayer:WaitForChild("PlayerGui")
Button.Parent = GUI
Button.Size = UDim2.new(0, 200, 0, 50)
Button.Position = UDim2.new(0, 50, 0, 50)
Button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.Text = "Start Farm"
Button.FontSize = Enum.FontSize.Size24

Button.MouseButton1Click:Connect(function()
    if isFarming then
        stopFarming()
        Button.Text = "Start Farm"
        Button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    else
        startFarming()
        Button.Text = "Stop Farm"
        Button.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

-- Notify
print("Lucky Blox Auto Farm Script Loaded!")
