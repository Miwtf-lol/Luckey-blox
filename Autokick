-- ===== CẤU HÌNH =====
local COLLECT_ZONE_NAMES = {
    "CollectZone", "COLLECT ZONE", "Collect", "CollectArea",
    "CollectionZone", "collectzone", "Collection_Zone"
}

local Network = ReplicatedStorage:FindFirstChild("Shared") 
    and ReplicatedStorage.Shared:FindFirstChild("Packages")
    and ReplicatedStorage.Shared.Packages:FindFirstChild("Network")

if not Network then
    -- Tìm trong toàn bộ ReplicatedStorage
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v.Name == "rev_KickEvent" or v.Name == "rev_Transformed" or v.Name == "rev_KickCollect" then
            Network = v.Parent
            break
        end
    end
end

-- ===== HÀM TELEPORT =====
function teleportTo(position, useTween)
    local character = LocalPlayer.Character
    if not character then
        local charLoaded = LocalPlayer.CharacterAdded:Wait(5)
        if not charLoaded then return false end
        character = LocalPlayer.Character
        task.wait(0.5)
    end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    
    if not hrp or not humanoid then return false end
    
    -- Chạy đến vị trí bằng CFrame
    hrp.CFrame = CFrame.new(position)
    
    -- Fire transformed event (nếu có)
    if Network and Network:FindFirstChild("rev_Transformed") then
        pcall(function()
            Network.rev_Transformed:FireServer()
        end)
    end
    
    return true
end

function findCollectZone()
    -- Tìm COLLECT ZONE trong workspace
    local function searchIn(container)
        for _, v in pairs(container:GetChildren()) do
            for _, name in pairs(COLLECT_ZONE_NAMES) do
                if v.Name == name then
                    return v
                end
            end
            -- Đệ quy tìm tiếp
            if v:IsA("Folder") or v:IsA("Model") then
                local found = searchIn(v)
                if found then return found end
            end
        end
        return nil
    end
    
    local zone = searchIn(workspace)
    
    -- Nếu không tìm thấy, tìm trong Areas
    local areas = workspace:FindFirstChild("Areas")
    if areas then
        zone = searchIn(areas)
    end
    
    -- Fallback: tìm tất cả parts có tên chứa "collect" hoặc "zone"
    if not zone then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                local name = v.Name:lower()
                if name:find("collect") and name:find("zone") then
                    zone = v
                    break
                end
            end
        end
    end
    
    -- Fallback cuối: tìm trong Plots 
    local plots = workspace:FindFirstChild("Plots")
    if not zone and plots then
        for _, plot in pairs(plots:GetChildren()) do
            for _, v in pairs(plot:GetDescendants()) do
                if v:IsA("BasePart") and (v.Name:lower():find("collect") or v.Name:lower():find("zone")) then
                    zone = v
                    break
                end
            end
            if zone then break end
        end
    end
    
    return zone
end

-- ===== HÀM KICK =====
function performKick()
    if not Network then return false end
    
    local kickEvent = Network:FindFirstChild("rev_KickEvent")
    if not kickEvent then return false end
    
    -- Args cho kick - thử các giá trị khác nhau
    local kickArgs = {
        -- Giá trị cao nhất cho perfect kick
        [1] = "Highest",      -- Thử 1
        -- [1] = "Perfect",   -- Thử 2
        -- [1] = "Max",       -- Thử 3
        -- [1] = true,        -- Thử 4
        -- [1] = 100,         -- Thử 5
    }
    
    -- Fire kick event
    local success = pcall(function()
        kickEvent:FireServer(unpack(kickArgs))
    end)
    
    if success then
        print("[KICK] Kicked successfully!")
        
        -- Click vào nếu có GUI upgrade
        pcall(function()
            local kickUpgrades = PlayerGui:FindFirstChild("KickUpgrades")
            if kickUpgrades then
                for _, v in pairs(kickUpgrades:GetChildren()) do
                    if (v.Name == "Bonus" or v.Name == "PopBonus") and v.Visible then
                        if v:FindFirstChild("ImageLabel") then
                            local img = v.ImageLabel
                            -- Fire connections
                            for _, conn in pairs(getconnections(img.MouseButton1Click)) do
                                conn:Fire()
                            end
                            for _, conn in pairs(getconnections(img.Activated)) do
                                conn:Fire()
                            end
                        end
                    end
                end
            end
        end)
        
        return true
    end
    
    return false
end

function collectAtZone()
    if not Network then return false end
    
    local kickCollect = Network:FindFirstChild("rev_KickCollect")
    if not kickCollect then return false end
    
    local success = pcall(function()
        kickCollect:FireServer()
    end)
    
    return success
end

-- ===== AUTO FARM LOOP =====
local isFarming = false
local farmLoop = nil

function startFarming()
    if isFarming then return end
    isFarming = true
    
    print("[FARM] Starting auto farm...")
    
    -- Delay để script ổn định
    task.wait(1)
    
    -- Tìm COLLECT ZONE
    local collectZone = findCollectZone()
    if collectZone then
        print("[FARM] Found Collect Zone: " .. collectZone.Name)
    else
        print("[FARM] Could not find Collect Zone. Using safe position.")
    end
    
    -- Farm loop
    farmLoop = task.spawn(function()
        while isFarming do
            pcall(function()
                -- 1. Đảm bảo đang ở COLLECT ZONE
                if collectZone then
                    local character = LocalPlayer.Character
                    if character then
                        local hrp = character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local dist = (hrp.Position - collectZone.Position).Magnitude
                            if dist > 15 then
                                print("[FARM] Teleporting to Collect Zone...")
                                teleportTo(collectZone.Position + Vector3.new(0, 5, 0))
                                task.wait(0.5)
                            end
                        end
                    end
                end
                
                -- 2. Fire collect event
                collectAtZone()
                task.wait(0.3)
                
                -- 3. Perform kick
                performKick()
                task.wait(0.3)
                
                -- 4. Click bonus popup nếu có
                pcall(function()
                    for _, v in pairs(PlayerGui:GetDescendants()) do
                        if v:IsA("ImageButton") or v:IsA("TextButton") then
                            local name = v.Name:lower()
                            if (name:find("bonus") or name:find("claim") or name:find("collect")) and v.Visible then
                                for _, conn in pairs(getconnections(v.MouseButton1Click)) do
                                    conn:Fire()
                                end
                                v:FireServer?  -- Nếu là RemoteEvent
                                break
                            end
                        end
                    end
                end)
                
                -- 5. Delay trước khi lặp lại
                task.wait(1.5)
            end)
        end
    end)
end

function stopFarming()
    isFarming = false
    if farmLoop then
        task.cancel(farmLoop)
        farmLoop = nil
    end
    print("[FARM] Stopped auto farm.")
end

