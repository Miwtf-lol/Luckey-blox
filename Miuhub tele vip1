    def decode_decimal_escapes(self, s: str) -> str:
        """Decode \\ddd decimal escape sequences to raw bytes."""
        result = []
        i = 0
        while i < len(s):
            if s[i:i+1] == '\\' and i+1 < len(s):
                # Check for \ddd (decimal escape)
                if s[i+1].isdigit():
                    # Read up to 3 digits
                    digits = ''
                    j = i + 1
                    while j < min(i + 4, len(s)) and s[j].isdigit():
                        digits += s[j]
                        j += 1
                    if digits:
                        result.append(chr(int(digits)))
                        i = j
                        continue
            result.append(s[i])
            i += 1
        return ''.join(result)
    
    def decode_constant_table(self) -> List[str]:
        """
        Extract and decode the constant table from the obfuscated script.
        
        The constant table looks like:
        local b = {"\\077\\084\\075...", "\\070\\098\\108...", ...}
        
        Each entry is decimal-escaped base64 which needs to be:
        1. Parse decimal escapes to raw bytes -> base64 string
        2. base64-decode -> actual constant value
        """
        # Find the constant table declaration
        pattern = r'local\s+[a-z]+\s*=\s*\{([^}]+)\}'
        match = re.search(pattern, self.raw_code)
        if not match:
            print("[!] Could not find constant table declaration")
            return []
        
        table_content = match.group(1)
        
        # Extract individual string entries
        # Entries are quoted strings like "\\077\\084..." or '\\077\\084...'
        string_pattern = r'["\']((?:\\\d{3}|[^"\'\\])*)["\']'
        entries = re.findall(string_pattern, table_content)
        
        print(f"[*] Found {len(entries)} entries in constant table")
        
        decoded_constants = []
        for i, entry in enumerate(entries):
            # Step 1: Decode decimal escapes to raw bytes
            raw_bytes = self.decode_decimal_escapes(entry)
            
            # Step 2: Base64 decode
            try:
                # Add padding if needed
                padding = 4 - len(raw_bytes) % 4
                if padding != 4:
                    raw_bytes += '=' * padding
                decoded = base64.b64decode(raw_bytes)
                decoded_constants.append(decoded)
            except Exception as e:
                print(f"  [!] Entry {i}: base64 decode failed: {e}")
                print(f"      Raw after escapes: {repr(raw_bytes[:50])}")
                decoded_constants.append(raw_bytes.encode('latin-1'))
        
        self.constants = decoded_constants
        return decoded_constants
    
