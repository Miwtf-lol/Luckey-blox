                r = state_8 % 32
                shift = 13 - (state_8 - r) / 32
                n = math.floor(state_45 / (2 ** shift)) % 4294967296 / (2 ** r)
                rnd = math.floor(n % 1 * 4294967296) + math.floor(n)
                
                low_16 = rnd % 65536
                high_16 = (rnd - low_16) / 65536
                
                b1 = int(low_16 % 256)
                b2 = int((low_16 - b1) / 256)
                b3 = int(high_16 % 256)
                b4 = int((high_16 - b3) / 256)
                prev_values.extend([b1, b2, b3, b4])
            
            return prev_values.pop()
        
