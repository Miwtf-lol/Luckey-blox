    def decrypt_string(self, ciphertext: str, seed: int) -> str:
        """
        Decrypt a string using the Prometheus EncryptStrings cipher.
        
        Implements the exact same algorithm from EncryptStrings.lua:
        - state_45 = seed % 35184372088832
        - state_8 = seed % 255 + 2
        - For each byte: prevVal = (cipher_byte + prng_byte + prevVal) % 256
        - Use charmap[prevVal + 1] for output
        
        Args:
            ciphertext: The encrypted string
            seed: The decryption seed
        
        Returns:
            Decrypted plaintext string
        """
        if not all([self.param_mul_45, self.param_add_45, self.param_mul_8]):
            print("[!] Cipher params not initialized")
            return ciphertext
        
        state_45 = seed % 35184372088832
        state_8 = seed % 255 + 2
        
        # Build charmap (256 chars in shuffled order)
        # The Prometheus code shuffles but uses charmap[n] = char(n-1)
        # So charmap[1] = chr(0), charmap[2] = chr(1), ..., charmap[256] = chr(255)
        charmap = [chr(i) for i in range(256)]  # charmap[n] = chr(n-1) when 1-indexed
        
        prev_values = []
        
        def get_next_prng_byte():
            nonlocal state_45, state_8
            if len(prev_values) == 0:
                # Update state_45
                state_45 = (state_45 * self.param_mul_45 + self.param_add_45) % 35184372088832
                # Update state_8 (ensure not 1)
