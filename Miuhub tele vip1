def download_pastebin(url: str) -> str:
    """Download content from pastebin."""
    import urllib.request
    try:
        with urllib.request.urlopen(url, timeout=30) as response:
            return response.read().decode('utf-8', errors='replace')
    except Exception as e:
        print(f"[!] Error downloading {url}: {e}")
        return ""


def main():
    if len(sys.argv) < 2:
        print("Usage: python deobfuscate.py <input_file_or_url>")
        print("  If argument is a URL (pastebin.com), it will be downloaded automatically")
        sys.exit(1)
    
    input_arg = sys.argv[1]
    
    # Check if it's a URL
    if input_arg.startswith('http://') or input_arg.startswith('https://'):
        print(f"[*] Downloading from {input_arg}...")
        code = download_pastebin(input_arg)
        if not code:
            print("[!] Download failed")
            sys.exit(1)
        print(f"[*] Downloaded {len(code)} bytes")
    else:
        # Read from file
        with open(input_arg, 'r', encoding='utf-8', errors='replace') as f:
            code = f.read()
        print(f"[*] Read {len(code)} bytes from {input_arg}")
    
    # Run deobfuscator
    deobf = PrometheusDeobfuscator(code)
    result = deobf.deobfuscate()
    
    # Write output
    output_file = sys.argv[2] if len(sys.argv) > 2 else "deobfuscated.lua"
    with open(output_file, 'w', encoding='utf-8') as f:
        f.write(result)
    
    print(f"\n[*] Output written to {output_file}")


if __name__ == "__main__":
    main()
