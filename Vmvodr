-- Hàm tìm GUI parent phù hợp
local function getGUIParent()
    local player = Players.LocalPlayer
    if player then
        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            return playerGui
        end
    end
    -- Fallback
    local coreGui = CoreGui
    if coreGui then
        return coreGui
    end
