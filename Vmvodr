    confirmButton.MouseLeave:Connect(function()
        TweenService:Create(confirmButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(88, 101, 242)}):Play()
    end)

    -- Xử lý nhấn nút
    confirmButton.MouseButton1Click:Connect(function()
        local enteredKey = textBox.Text:gsub("%s+", "")  -- Xóa khoảng trắng
        
        if enteredKey == CORRECT_KEY then
            KEY_ENTERED = true
            errorLabel.Text = ""
            errorLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
            errorLabel.Text = "✅ Key hợp lệ! Đang khởi động..."
            
            -- Xóa GUI sau 0.5 giây
            task.wait(0.5)
            gui:Destroy()
            
