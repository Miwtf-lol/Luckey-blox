end

-- ===== HÀM LẤY PET =====
local function collectAllPets()
    local collected = 0
    local houseArea = workspace:FindFirstChild("House") or workspace:FindFirstChild("HouseInterior")
    
    local targets = {}
    if houseArea then
        for _, obj in ipairs(houseArea:GetChildren()) do
            table.insert(targets, obj)
        end
    else
        for _, obj in ipairs(workspace:GetChildren()) do
            table.insert(targets, obj)
        end
    end
    
    for _, obj in ipairs(targets) do
        if obj:IsA("Model") and (obj.Name:lower():find("pet") or obj.Name:lower():find("egg") or obj.Name:lower():find("chest")) then
            local success = pcall(function()
                Network.rev_S_Interact:InvokeServer(obj)
            end)
            if success then
                collected = collected + 1
            end
        end
    end
    
    return collected
end

-- ===== HÀM GỬI PET =====
local function sendPetsToTarget()
    local targetPlayer = Players:FindFirstChild(CONFIG.TARGET_PLAYER)
    if not targetPlayer then return false end
    
    local args = {
        [1] = targetPlayer,
        [2] = "all",
        [3] = true,
    }
    
    local success = pcall(function()
        Network.rev_GiftRequest:FireServer(unpack(args))
    end)
    
    return success
end

-- ===== VÒNG LẶP CHÍNH =====
local function startProcessing(statusLabel, mainBtn)
    if isProcessing then return end
    if CONFIG.TARGET_PLAYER == "username_here" then
        if statusLabel then statusLabel.Text = "⚠️ CHƯA SET TARGET PLAYER!" end
        return
    end
    
    isProcessing = true
    local round = 0
    local totalCollected = 0
    
    processingLoop = task.spawn(function()
        while isProcessing do
            round = round + 1
            
            -- Bước 1: Lấy pet
            if statusLabel then statusLabel.Text = "🔄 Vòng " .. round .. ": Đang lấy pet..." end
            local collected = collectAllPets()
            totalCollected = totalCollected + collected
            
            if collected == 0 then
                -- Hết pet rồi → dừng
                if statusLabel then statusLabel.Text = "✅ HOÀN TẤT! Đã lấy hết pet. Tổng: " .. totalCollected .. " pet qua " .. round .. " vòng" end
                isProcessing = false
                if mainBtn then
                    mainBtn.Text = "▶ BẮT ĐẦU LẤY PET & GỬI"
                    mainBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
                end
                break
            end
            
            -- Bước 2: Gửi pet
            if statusLabel then statusLabel.Text = "📦 Vòng " .. round .. ": Đã lấy " .. collected .. " pet, đang gửi..." end
            local sent = sendPetsToTarget()
            
            if sent then
                if statusLabel then statusLabel.Text = "✅ Vòng " .. round .. ": +" .. collected .. " pet → Đã gửi cho " .. CONFIG.TARGET_PLAYER .. " (Tổng: " .. totalCollected .. ")" end
            else
                if statusLabel then statusLabel.Text = "⚠️ Vòng " .. round .. ": Lấy " .. collected .. " pet nhưng gửi thất bại" end
            end
            
            task.wait(0.5)
        end
        
        isProcessing = false
        if mainBtn then
            mainBtn.Text = "▶ BẮT ĐẦU LẤY PET & GỬI"
            mainBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        end
    end)
end

