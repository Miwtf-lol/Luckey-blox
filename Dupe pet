------------------------------------------------
-- HÀM DUPE ĐỒ
------------------------------------------------

local function DupeItems()
	local success, result = pcall(function()
		return DupeRemote:InvokeServer()
	end)
	
	if success then
		if result then
			StatusDupe.Text = "✅ Dupe success! " .. tostring(result)
		else
			StatusDupe.Text = "✅ Dupe completed!"
		end
	else
		StatusDupe.Text = "❌ Dupe failed: " .. tostring(result)
	end
	
	return success
end

