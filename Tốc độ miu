-- Hàm tìm RemoteEvent/Function để kick
local function FindKickRemote()
    -- Tìm remote kick trong game (thường là RemoteEvent)
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") and string.find(string.lower(v.Name), "kick") then
            return v
        end
        if v:IsA("RemoteFunction") and string.find(string.lower(v.Name), "kick") then
            return v
        end
    end
    -- Thử tìm bằng tên phổ biến
    local commonNames = {"KickBlock", "Kick", "BlockKick", "RemoteKick", "KickEvent"}
    for _, name in pairs(commonNames) do
        local found = game:GetService("ReplicatedStorage"):FindFirstChild(name, true)
        if found and (found:IsA("RemoteEvent") or found:IsA("RemoteFunction")) then
            return found
        end
    end
    return nil
end

-- Hàm tìm Remote để chạy/speed
local function FindSpeedRemote()
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") and (string.find(string.lower(v.Name), "speed") or string.find(string.lower(v.Name), "run")) then
            return v
        end
    end
    return nil
end

-- AUTO KICK FUNCTION
local function StartAutoKick()
    if kickConnection then kickConnection:Disconnect() kickConnection = nil end
    
    local remote = FindKickRemote()
    if not remote then
        -- Fallback: simulate spacebar spam
        kickConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if autoKickEnabled then
                local char = player.Character
                if char and char:FindFirstChild("Humanoid") then
                    -- Thử kick bằng cách mô phỏng hành động
                    pcall(function()
                        remote = FindKickRemote()
                        if remote then
                            remote:FireServer()
                        end
                    end)
                end
            end
        end)
    else
        kickConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if autoKickEnabled then
                pcall(function()
                    if remote:IsA("RemoteEvent") then
                        remote:FireServer()
                    elseif remote:IsA("RemoteFunction") then
                        remote:InvokeServer()
                    end
                end)
            end
        end)
    end
end

local function StopAutoKick()
    if kickConnection then
        kickConnection:Disconnect()
        kickConnection = nil
    end
end

-- AUTO RUN FROM TSUNAMI FUNCTION
local function StartAutoRun()
    if runConnection then runConnection:Disconnect() runConnection = nil end
    
    runConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if autoRunEnabled and player.Character then
            local char = player.Character
            local humanoid = char:FindFirstChild("Humanoid")
            local rootPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            
            if humanoid and rootPart then
                -- Tìm hướng về base/home (thường là spawn location)
                local spawns = game:GetService("Workspace"):FindFirstChild("SpawnLocation")
                or game:GetService("Workspace"):FindFirstChild("Base")
                or game:GetService("Workspace"):FindFirstChild("Home")
                or game:GetService("Workspace"):FindFirstChild("Plot")
                
                if spawns then
                    local targetPos = spawns.Position
                    local direction = (targetPos - rootPart.Position).Unit
                    
                    -- Di chuyển về base với tốc độ được điều chỉnh
                    local speedMult = currentSpeed / 50 -- 50 là mặc định
                    local moveVector = Vector3.new(direction.X, 0, direction.Z) * speedMult
                    
                    humanoid:Move(moveVector)
                else
                    -- Fallback: chạy về tọa độ 0,0,0
                    local targetPos = Vector3.new(0, rootPart.Position.Y, 0)
                    local direction = (targetPos - rootPart.Position).Unit
                    local speedMult = currentSpeed / 50
                    local moveVector = Vector3.new(direction.X, 0, direction.Z) * speedMult
                    humanoid:Move(moveVector)
                end
            end
        end
    end)
end

local function StopAutoRun()
    if runConnection then
        runConnection:Disconnect()
        runConnection = nil
    end
end

